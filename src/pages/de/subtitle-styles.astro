---
import Layout from '../../layouts/Layout.astro';
import { t, getLocalizedUrl } from '../../i18n/utils';

const lang = 'de';

const stylesList = [
  { id: 'hormozi', name: 'Hormozi Punch', tag: 'Shorts & Reels', class: 'sub-style-hormozi', sampleWords: ['ERFOLG', 'DURCH', 'FOKUS', 'HEUTE'], activeIdx: 2 },
  { id: 'beast', name: 'MrBeast Pop', tag: 'Gaming & Energy', class: 'sub-style-beast', sampleWords: ['CHALLENGE', 'JETZT', 'GESTARTET'], activeIdx: 0 },
  { id: 'cinematic', name: 'Cinematic Box', tag: 'Filme & Doku', class: 'sub-style-cinematic', sampleWords: ['Eine', 'wahre', 'Geschichte', 'erzählt'], activeIdx: 2 },
  { id: 'neon', name: 'Cyberpunk Neon', tag: 'Tech & Musik', class: 'sub-style-neon', sampleWords: ['ZUKUNFT', 'DER', 'KI'], activeIdx: 0 },
  { id: 'karaoke', name: 'Karaoke Wave', tag: 'Musik & Voice', class: 'sub-style-karaoke', sampleWords: ['Jedes', 'Wort', 'im', 'Takt'], activeIdx: 1 },
  { id: 'minimal', name: 'Minimalistisch', tag: 'Business & Kurse', class: 'sub-style-minimal', sampleWords: ['Klarheit', 'und', 'Präzision'], activeIdx: 0 },
];
---

<Layout lang={lang} path="/subtitle-styles" title={t(lang, 'styles.title') + ' — Subtitle Generator Free'}>
  <section class="bg-[var(--color-canvas)] border-b border-[var(--color-hairline)] pt-16 pb-12">
    <div class="container-page max-w-4xl mx-auto text-center flex flex-col items-center gap-4">
      <span class="eyebrow">{t(lang, 'nav.styles')}</span>
      <h1 class="display-xl text-[var(--color-ink)] font-extrabold">{t(lang, 'styles.title')}</h1>
    </div>
  </section>
  <section class="py-16 md:py-24 bg-[var(--color-canvas-soft)]">
    <div class="container-page max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {stylesList.map((style) => (
        <div class="flex flex-col rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 overflow-hidden p-6 gap-4">
          <div class="w-full h-40 bg-zinc-950 rounded-xl flex items-center justify-center p-4">
            <div class:list={[style.class, 'text-xl text-center']}>
              {style.sampleWords.map((w, idx) => (
                <span class:list={['inline-block mx-1', idx === style.activeIdx ? 'word-active' : '']}>{w}</span>
              ))}
            </div>
          </div>
          <div class="flex justify-between items-center">
            <h2 class="text-base font-bold text-[var(--color-ink)]">{style.name}</h2>
            <span class="px-2 py-0.5 text-xs rounded-full bg-[var(--color-link-bg-soft)] text-[var(--color-link)] font-semibold">{style.tag}</span>
          </div>
          <a href={getLocalizedUrl(lang, '/#subtitle-studio')} class="mt-auto w-full h-10 flex items-center justify-center text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)]">
            Im Studio verwenden
          </a>
        </div>
      ))}
    </div>
  </section>
</Layout>
