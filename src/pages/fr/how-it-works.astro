---
import Layout from '../../layouts/Layout.astro';
import { t, getLocalizedUrl } from '../../i18n/utils';
const lang = 'fr';
---
<Layout lang={lang} path="/how-it-works" title={t(lang,'nav.howItWorks') + ' — Font Finder AI'}>
  <section class="bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" style="padding-top:64px;padding-bottom:64px;">
    <div class="container-page max-w-3xl mx-auto text-center">
      <h1 class="display-xl text-[var(--color-ink)]">{t(lang,'hiw.title')}</h1>
    </div>
  </section>
  <section class="bg-[var(--color-canvas-soft)]" style="padding-top:96px;padding-bottom:96px;">
    <div class="container-page max-w-3xl mx-auto flex flex-col gap-12">
      {[
        {num:'01',t:'how.step1.title' as const,b:'how.step1.body' as const},
        {num:'02',t:'how.step2.title' as const,b:'how.step2.body' as const},
        {num:'03',t:'how.step3.title' as const,b:'how.step3.body' as const},
      ].map(({num,t:tk,b:bk}) => (
        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-12 h-12 rounded-full bg-[var(--color-ink)] text-[var(--color-on-primary)] flex items-center justify-center text-sm font-semibold font-mono">{num}</div>
          <div><h2 class="display-sm text-[var(--color-ink)]">{t(lang,tk)}</h2><p class="text-base text-[var(--color-body)] mt-2 leading-relaxed">{t(lang,bk)}</p></div>
        </div>
      ))}
    </div>
  </section>
  <section class="bg-[var(--color-contrast-section)] text-[var(--color-contrast-section-text)] border-t border-[var(--color-hairline)] transition-colors" style="padding-top:64px;padding-bottom:64px;">
    <div class="container-page text-center">
      <a href={getLocalizedUrl(lang,'/')} class="inline-flex items-center h-12 px-8 text-base font-medium rounded-pill bg-[var(--color-contrast-section-btn-bg)] text-[var(--color-contrast-section-btn-text)] hover:opacity-90 transition-opacity shadow-l2">{t(lang,'cta.button')}</a>
    </div>
  </section>
</Layout>
