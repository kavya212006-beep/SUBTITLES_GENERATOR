---
import Layout from '../layouts/Layout.astro';
import HeroGradient from '../components/HeroGradient.astro';
import SubtitleStudio from '../components/SubtitleStudio/SubtitleStudio.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import StyleShowcase from '../components/StyleShowcase.astro';
import CompetitorComparison from '../components/CompetitorComparison.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { t, getLocalizedUrl } from '../i18n/utils';

const lang = 'en';
---

<Layout
  lang={lang}
  path="/"
  title="Subtitle Generator Free — AI Subtitles from Audio, Video & Script"
  description="Generate viral animated subtitles from audio, video, or script in seconds. Auto-transcribe speech, sync custom scripts, apply trending styles (Hormozi, MrBeast, Karaoke), and export SRT/VTT for free."
>
  <!-- Hero Section with Mesh Gradient -->
  <HeroGradient lang={lang} />

  <!-- Core Subtitle Studio Interactive Web Application -->
  <section class="container-page pb-20 -mt-6">
    <SubtitleStudio lang={lang} />
  </section>

  <!-- Key Features Grid -->
  <FeaturesGrid lang={lang} />

  <!-- Trending Style Showcase Gallery -->
  <StyleShowcase lang={lang} />

  <!-- Competitor Comparison (vs InVideo, CapCut, Kapwing) -->
  <CompetitorComparison lang={lang} />

  <!-- Trust & Privacy Band -->
  <section class="py-16 bg-[var(--color-contrast-section)] text-[var(--color-contrast-section-text)] border-t border-[var(--color-hairline)] transition-colors">
    <div class="container-page max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
      <div class="flex flex-col gap-2 max-w-xl">
        <h3 class="text-xl md:text-2xl font-bold">{t(lang, 'trust.title')}</h3>
        <p class="text-sm opacity-80 leading-relaxed">{t(lang, 'trust.privacy')}</p>
      </div>
      <div class="flex items-center gap-8 shrink-0">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-extrabold font-mono text-[var(--color-link)]">{t(lang, 'trust.stat1')}</span>
          <span class="text-xs opacity-75 mt-1">{t(lang, 'trust.stat1.label')}</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-extrabold font-mono text-emerald-400">{t(lang, 'trust.stat2')}</span>
          <span class="text-xs opacity-75 mt-1">{t(lang, 'trust.stat2.label')}</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-extrabold font-mono text-amber-400">{t(lang, 'trust.stat3')}</span>
          <span class="text-xs opacity-75 mt-1">{t(lang, 'trust.stat3.label')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive SEO FAQs with Schema -->
  <FaqAccordion lang={lang} />

  <!-- Bottom CTA Band -->
  <section class="py-20 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] text-center">
    <div class="container-page max-w-3xl mx-auto flex flex-col items-center gap-6">
      <h2 class="display-lg text-[var(--color-ink)] font-bold">
        {t(lang, 'cta.title')}
      </h2>
      <p class="text-sm md:text-base text-[var(--color-body)] max-w-xl leading-relaxed">
        {t(lang, 'cta.subtitle')}
      </p>
      <a
        href="#subtitle-studio"
        class="inline-flex items-center justify-center h-12 px-8 text-sm font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l2"
      >
        {t(lang, 'cta.button')}
      </a>
    </div>
  </section>
</Layout>
