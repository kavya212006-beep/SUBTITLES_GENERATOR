---
import { t, getLocalizedUrl } from '../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylesList = [
  {
    id: 'hormozi',
    nameKey: 'styles.hormozi',
    class: 'sub-style-hormozi',
    words: ['NEVER', 'GIVE', 'UP', 'TODAY'],
    desc: 'High-contrast bold punch designed for high retention on YouTube Shorts & TikTok.',
  },
  {
    id: 'beast',
    nameKey: 'styles.beast',
    class: 'sub-style-beast',
    words: ['WIN', '$100,000', 'RIGHT', 'NOW'],
    desc: 'Heavy 2px black outline with vibrant neon blue bounce for gaming and high-energy content.',
  },
  {
    id: 'cinematic',
    nameKey: 'styles.cinematic',
    class: 'sub-style-cinematic',
    words: ['The', 'untold', 'story', 'revealed'],
    desc: 'Frosted translucent backdrop box tailored for documentaries, interviews, and brand videos.',
  },
  {
    id: 'neon',
    nameKey: 'styles.neon',
    class: 'sub-style-neon',
    words: ['CYBERPUNK', 'NEON', 'VIBES', 'ONLY'],
    desc: 'Electric cyan and magenta glow effects perfect for music clips, gaming, and tech reels.',
  },
  {
    id: 'karaoke',
    nameKey: 'styles.karaoke',
    class: 'sub-style-karaoke',
    words: ['Sing', 'along', 'with', 'every', 'beat'],
    desc: 'Progressive vibrant green highlight wave that guides the viewer word-by-word.',
  },
  {
    id: 'minimal',
    nameKey: 'styles.minimal',
    class: 'sub-style-minimal',
    words: ['Simple.', 'Clean.', 'Effective.', 'Design.'],
    desc: 'Understated elegance for tutorials, podcasts, and corporate presentations.',
  },
];
---

<section class="py-16 md:py-24 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]">
  <div class="container-page max-w-6xl mx-auto flex flex-col gap-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-3">
      <span class="eyebrow">{t(lang, 'nav.styles')}</span>
      <h2 class="display-lg text-[var(--color-ink)] font-bold">
        {t(lang, 'styles.title')}
      </h2>
      <p class="text-sm md:text-base text-[var(--color-body)] leading-relaxed">
        Choose from trending typography presets or customize animations to fit your brand identity.
      </p>
    </div>

    <!-- Styles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {stylesList.map((st) => (
        <div class="flex flex-col gap-4 p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] shadow-l1 hover:shadow-l3 hover:border-[var(--color-hairline-strong)] transition-all">
          
          <!-- Visual Preview Box -->
          <div class="w-full h-36 rounded-xl bg-zinc-950 flex items-center justify-center p-4 relative overflow-hidden border border-zinc-800">
            <!-- Simulated background light -->
            <div class="absolute inset-0 bg-radial from-indigo-950/40 to-transparent"></div>
            
            <div class:list={[st.class, 'text-xl md:text-2xl text-center relative z-10']}>
              {st.words.map((w, idx) => (
                <span class:list={['inline-block mx-1', idx === 1 ? 'word-active' : '']}>{w}</span>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <h3 class="text-base font-bold text-[var(--color-ink)]">
              {t(lang, st.nameKey as any)}
            </h3>
            <p class="text-xs text-[var(--color-mute)] leading-relaxed">
              {st.desc}
            </p>
          </div>

          <a
            href={getLocalizedUrl(lang, '/#subtitle-studio')}
            class="mt-auto inline-flex items-center text-xs font-semibold text-[var(--color-link)] hover:underline pt-2"
          >
            Apply this style in Studio →
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
