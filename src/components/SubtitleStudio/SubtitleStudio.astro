                <div class="flex items-center rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-0.5 text-xs">
                  <button id="case-upper-btn" class="px-2 py-1 rounded font-bold bg-[var(--color-ink)] text-[var(--color-on-primary)] cursor-pointer">UPPER</button>
