            <!-- Row 2: Position & Font Size Sliders -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-[var(--color-hairline)]">
              <!-- Position Controls -->
              <div class="flex flex-col gap-1.5">
