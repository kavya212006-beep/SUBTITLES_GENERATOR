                  <div class="flex gap-1 shrink-0">
                    <button class="pos-preset-btn px-2 py-1 text-xs font-medium rounded border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] cursor-pointer" data-pos="80">Top</button>
                    <button class="pos-preset-btn px-2 py-1 text-xs font-medium rounded border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] cursor-pointer" data-pos="50">Mid</button>
                    <button class="pos-preset-btn px-2 py-1 text-xs font-medium rounded border border-[var(--color-link)] bg-[var(--color-ink)] text-[var(--color-on-primary)] cursor-pointer" data-pos="18">Bot</button>
                  </div>
                  <input
                    id="pos-slider"
