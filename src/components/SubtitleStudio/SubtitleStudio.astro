  // Render Canvas animated particles / dynamic background
  function drawCanvasFrame(time: number) {
    if (!ctx || !canvas) return;
    const w = canvas.width;
    const h = canvas.height;

    // Dark gradient background
    const grad = ctx.createRadialGradient(
      w * 0.5 + Math.sin(time * 0.002) * w * 0.3,
      h * 0.4 + Math.cos(time * 0.002) * h * 0.2,
      20,
      w * 0.5,
      h * 0.5,
      w * 0.8
    );
    grad.addColorStop(0, '#1e1b4b'); // Deep indigo
    grad.addColorStop(0.5, '#0f172a'); // Slate
    grad.addColorStop(1, '#020617'); // Black
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    // Floating glowing orbs
    const numOrbs = 3;
    for (let i = 0; i < numOrbs; i++) {
      const angle = (time * 0.001) + (i * (Math.PI * 2 / numOrbs));
      const ox = w * 0.5 + Math.cos(angle) * (w * 0.28);
      const oy = h * 0.5 + Math.sin(angle * 1.3) * (h * 0.25);
      const rad = 60 + i * 20;

      const orbGrad = ctx.createRadialGradient(ox, oy, 0, ox, oy, rad);
      if (i === 0) {
        orbGrad.addColorStop(0, 'rgba(0, 223, 216, 0.35)');
        orbGrad.addColorStop(1, 'rgba(0, 223, 216, 0)');
      } else if (i === 1) {
        orbGrad.addColorStop(0, 'rgba(255, 0, 128, 0.3)');
        orbGrad.addColorStop(1, 'rgba(255, 0, 128, 0)');
      } else {
        orbGrad.addColorStop(0, 'rgba(121, 40, 202, 0.35)');
        orbGrad.addColorStop(1, 'rgba(121, 40, 202, 0)');
      }
      ctx.fillStyle = orbGrad;
      ctx.beginPath();
      ctx.arc(ox, oy, rad, 0, Math.PI * 2);
      ctx.fill();
    }

    // Grid lines for cinematic tech feel
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }
  }

  // Active Subtitle Word Rendering
  function updateSubtitleOverlay() {
    if (!subtitleRenderedText) return;

    // Find current active cue
    const activeCue = currentCues.find(c => currentTime >= c.start && currentTime <= c.end);

    if (!activeCue) {
      subtitleRenderedText.innerHTML = `<span class="opacity-30">...</span>`;
      return;
    }

    // Calculate which word inside cue is active based on cue progress
    const words = activeCue.text.trim().split(/\s+/);
    const cueDuration = activeCue.end - activeCue.start;
    const progressInCue = Math.max(0, Math.min(1, (currentTime - activeCue.start) / cueDuration));
    const activeWordIndex = Math.min(words.length - 1, Math.floor(progressInCue * words.length));

    // Render words with active highlighted word
    subtitleRenderedText.innerHTML = words.map((w, idx) => {
      const isActive = idx === activeWordIndex;
      return `<span class="${isActive ? 'word-active' : ''} inline-block mx-1 transition-transform duration-100">${w}</span>`;
    }).join('');
  }

  // Animation Loop
  function tick(timestamp: number) {
    if (!lastTimestamp) lastTimestamp = timestamp;
    const delta = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;

    if (isPlaying) {
      currentTime += delta;
      if (currentTime >= duration) {
        currentTime = 0;
      }
      updateTimeUI();
    }

    drawCanvasFrame(timestamp);
    updateSubtitleOverlay();

    animFrameId = requestAnimationFrame(tick);
  }

  function togglePlay() {
    isPlaying = !isPlaying;
    if (playIcon) playIcon.textContent = isPlaying ? '❚❚' : '▶';
    if (miniPlayBtn) miniPlayBtn.textContent = isPlaying ? '❚❚' : '▶';
