              >
            </div>
            <button
              id="add-cue-btn"
              class="text-xs font-semibold text-[var(--color-link)] hover:underline flex items-center gap-1 cursor-pointer"
            >
              <span>+</span>
              <span>{t(lang, "timeline.add")}</span>
