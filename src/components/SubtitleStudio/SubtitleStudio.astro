            >Universal formats ready for TikTok, Reels, YouTube Shorts, Premiere Pro & CapCut</span
          >
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            id="burn-video-btn"
            class="h-10 px-5 text-xs font-semibold rounded-pill bg-gradient-to-r from-[var(--color-link)] to-[var(--color-violet)] text-white hover:opacity-90 transition-all shadow-l2 flex items-center gap-2 cursor-pointer"
          >
            <span>🎬</span>
            <span id="burn-video-label">Download Video with Subtitles</span>
          </button>
          <button
            id="export-srt-btn"
            class="h-10 px-4 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l1 flex items-center gap-1.5 cursor-pointer"
          >
            <span>📥</span>
            <span>{t(lang, "export.srt")}</span>
