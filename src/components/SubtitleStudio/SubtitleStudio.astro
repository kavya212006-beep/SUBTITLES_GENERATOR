          <button
            id="export-vtt-btn"
            class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>📄</span>
            <span>{t(lang, "export.vtt")}</span>
          </button>
          <button
            id="export-txt-btn"
            class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>📝</span>
            <span>{t(lang, "export.txt")}</span>
          </button>
          <button
            id="copy-all-btn"
            class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors cursor-pointer"
          >
            {t(lang, "export.copy")}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ─── Client Script Engine ───────────────────────────────── -->
<script>
  interface SubtitleCue {
    id: string;
    start: number; // in seconds
    end: number;
    text: string;
  }

  // Preloaded Demo Samples
  const demoSamples: Record<string, SubtitleCue[]> = {
    hormozi: [
      { id: "1", start: 0.0, end: 2.2, text: "IF YOU WANT WHAT 1% HAVE 🔥" },
      { id: "2", start: 2.3, end: 4.8, text: "DO WHAT 99% WON'T ⚡" },
      { id: "3", start: 4.9, end: 7.2, text: "FOCUS EVERY SINGLE DAY 🎯" },
      { id: "4", start: 7.3, end: 9.8, text: "CONSISTENCY ALWAYS WINS 🏆" },
      { id: "5", start: 9.9, end: 12.5, text: "START CREATING TODAY 🚀" },
    ],
    motivation: [
      { id: "1", start: 0.0, end: 2.4, text: "I GAVE 100 STRANGERS $10,000 💰" },
      { id: "2", start: 2.5, end: 5.0, text: "TO SURVIVE 24 HOURS HERE ⚡" },
      { id: "3", start: 5.1, end: 7.5, text: "WATCH WHAT HAPPENS NEXT 😱" },
      { id: "4", start: 7.6, end: 10.0, text: "THE FINAL CHALLENGE BEGINS 💥" },
    ],
    tutorial: [
      { id: "1", start: 0.0, end: 2.4, text: "GENERATE VIRAL SUBTITLES FAST 🎬" },
      { id: "2", start: 2.5, end: 5.0, text: "AUTO SYNC YOUR VIDEO & AUDIO ✨" },
      { id: "3", start: 5.1, end: 7.6, text: "APPLY TRENDING HORMOZI STYLES 🔥" },
      { id: "4", start: 7.7, end: 10.5, text: "EXPORT FREE SRT OR BURNED VIDEO 🚀" },
    ],
  };

  // State
  let currentCues: SubtitleCue[] = [...demoSamples.hormozi];
  let currentStyle = "hormozi";
  let activeColor = "#facc15";
  let isPlaying = false;
  let currentTime = 0;
  let duration = 12.5;
  let animFrameId: number | null = null;
  let lastTimestamp = 0;
  let isCustomMediaLoaded = false;
  let mediaType: "video" | "audio" | "none" = "none";
  let audioContext: AudioContext | null = null;
  let audioAnalyser: AnalyserNode | null = null;
  let audioDataArray: Uint8Array | null = null;

  // DOM Elements
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".studio-tab-btn");
  const panels = {
    audio: document.getElementById("panel-audio"),
    script: document.getElementById("panel-script"),
    editor: document.getElementById("panel-editor"),
  };

  const canvas = document.getElementById("motion-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");
  const userVideoEl = document.getElementById("user-video") as HTMLVideoElement;
  const userAudioEl = document.getElementById("user-audio") as HTMLAudioElement;
  const subtitleRenderedText = document.getElementById("subtitle-rendered-text");
  const subtitleOverlayBox = document.getElementById("subtitle-overlay-box");
  const playBtn = document.getElementById("video-play-btn");
  const miniPlayBtn = document.getElementById("mini-play-btn");
  const playIcon = document.getElementById("play-icon");
  const seekbar = document.getElementById("video-seekbar") as HTMLInputElement;
  const timeDisplay = document.getElementById("time-display");
  const cuesContainer = document.getElementById("cues-container");
  const cueCountBadge = document.getElementById("cue-count-badge");
  const audioBadge = document.getElementById("audio-badge");
  const audioFilenameBadge = document.getElementById("audio-filename-badge");
  const viewport = document.getElementById("video-viewport");

  function resizeCanvas() {
    if (!canvas || !viewport) return;
    canvas.width = viewport.clientWidth || 340;
    canvas.height = viewport.clientHeight || 604;
  }
  window.addEventListener("resize", resizeCanvas);
  resizeCanvas();

  // Tab Switching
  function switchTab(target: "audio" | "script" | "editor") {
    tabBtns.forEach((btn) => {
      const isTarget = btn.id === `tab-btn-${target}`;
      btn.setAttribute("aria-selected", String(isTarget));
      btn.classList.toggle("border-[var(--color-ink)]", isTarget);
      btn.classList.toggle("text-[var(--color-ink)]", isTarget);
      btn.classList.toggle("font-semibold", isTarget);
      btn.classList.toggle("border-transparent", !isTarget);
      btn.classList.toggle("text-[var(--color-mute)]", !isTarget);
      btn.classList.toggle("font-medium", !isTarget);
    });

    Object.entries(panels).forEach(([key, panel]) => {
      panel?.classList.toggle("hidden", key !== target);
    });

    if (target === "editor") {
      setTimeout(resizeCanvas, 60);
    }
  }

  document.getElementById("tab-btn-audio")?.addEventListener("click", () => switchTab("audio"));
  document.getElementById("tab-btn-script")?.addEventListener("click", () => switchTab("script"));
  document.getElementById("tab-btn-editor")?.addEventListener("click", () => switchTab("editor"));

  // Canvas Dynamic Background & Audio Visualizer
  function drawCanvasFrame(time: number) {
    if (!ctx || !canvas) return;
    const w = canvas.width;
    const h = canvas.height;

    // Dark sleek gradient background
    const grad = ctx.createRadialGradient(
      w * 0.5 + Math.sin(time * 0.0015) * w * 0.25,
      h * 0.4 + Math.cos(time * 0.0015) * h * 0.2,
      20,
      w * 0.5,
      h * 0.5,
      w * 0.8
    );
    grad.addColorStop(0, "#1e1b4b");
    grad.addColorStop(0.5, "#090d16");
    grad.addColorStop(1, "#020408");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    // Glowing Ambient Orbs
    const numOrbs = 3;
    for (let i = 0; i < numOrbs; i++) {
      const angle = time * 0.0008 + i * ((Math.PI * 2) / numOrbs);
      const ox = w * 0.5 + Math.cos(angle) * (w * 0.3);
      const oy = h * 0.5 + Math.sin(angle * 1.2) * (h * 0.25);
      const rad = 70 + i * 25;

      const orbGrad = ctx.createRadialGradient(ox, oy, 0, ox, oy, rad);
      if (i === 0) {
        orbGrad.addColorStop(0, "rgba(0, 223, 216, 0.25)");
        orbGrad.addColorStop(1, "rgba(0, 223, 216, 0)");
      } else if (i === 1) {
        orbGrad.addColorStop(0, "rgba(255, 0, 128, 0.22)");
        orbGrad.addColorStop(1, "rgba(255, 0, 128, 0)");
      } else {
        orbGrad.addColorStop(0, "rgba(121, 40, 202, 0.25)");
        orbGrad.addColorStop(1, "rgba(121, 40, 202, 0)");
      }
      ctx.fillStyle = orbGrad;
      ctx.beginPath();
      ctx.arc(ox, oy, rad, 0, Math.PI * 2);
      ctx.fill();
    }

    // Audio Frequency Visualizer (if audio file loaded)
    if (mediaType === "audio" && audioAnalyser && audioDataArray) {
      audioAnalyser.getByteFrequencyData(audioDataArray);
      const bars = 24;
      const barWidth = w / (bars * 1.6);
      const startX = (w - bars * barWidth * 1.4) / 2;
      const centerY = h * 0.5;

      for (let b = 0; b < bars; b++) {
        const val = audioDataArray[b * 2] || 10;
        const barHeight = Math.max(6, (val / 255) * (h * 0.35));
        const bx = startX + b * (barWidth * 1.4);

        const barGrad = ctx.createLinearGradient(0, centerY - barHeight / 2, 0, centerY + barHeight / 2);
        barGrad.addColorStop(0, "#38bdf8");
        barGrad.addColorStop(0.5, "#facc15");
        barGrad.addColorStop(1, "#ec4899");

        ctx.fillStyle = barGrad;
        ctx.beginPath();
        ctx.roundRect(bx, centerY - barHeight / 2, barWidth, barHeight, 4);
        ctx.fill();
      }
    }
  }

  // Active Subtitle Word Rendering Cache (prevents DOM thrashing)
  let lastRenderedCueId = "";
  let lastActiveWordIdx = -1;

  function updateSubtitleOverlay() {
    if (!subtitleRenderedText) return;

    // Find current active cue
    const activeCue = currentCues.find(
      (c) => currentTime >= c.start && currentTime <= c.end
    );

    if (!activeCue) {
      if (lastRenderedCueId !== "__none__") {
        subtitleRenderedText.innerHTML = `<span class="opacity-30">...</span>`;
        lastRenderedCueId = "__none__";
        lastActiveWordIdx = -1;
      }
      return;
    }

    // Calculate active word index
    const words = activeCue.text.trim().split(/\s+/);
    const cueDuration = Math.max(0.1, activeCue.end - activeCue.start);
    const progressInCue = Math.max(
      0,
      Math.min(1, (currentTime - activeCue.start) / cueDuration)
    );
    const activeWordIndex = Math.min(
      words.length - 1,
      Math.floor(progressInCue * words.length)
    );

    if (lastRenderedCueId !== activeCue.id || lastActiveWordIdx !== activeWordIndex) {
      lastRenderedCueId = activeCue.id;
      lastActiveWordIdx = activeWordIndex;

      subtitleRenderedText.innerHTML = words
        .map((w, idx) => {
          const isActive = idx === activeWordIndex;
          return `<span class="${isActive ? "word-active" : ""} inline-block mx-1 transition-transform duration-100">${w}</span>`;
        })
        .join("");
    }
  }

  function formatTime(sec: number): string {
    const s = Math.max(0, Math.floor(sec));
    const m = Math.floor(s / 60);
    const remS = s % 60;
    return `${String(m).padStart(2, "0")}:${String(remS).padStart(2, "0")}`;
  }

  function updateTimeUI() {
    if (seekbar) {
      seekbar.value = String(duration > 0 ? (currentTime / duration) * 100 : 0);
    }
    if (timeDisplay) {
      timeDisplay.textContent = `${formatTime(currentTime)} / ${formatTime(duration)}`;
    }
  }

  function seekTo(time: number) {
    currentTime = Math.max(0, Math.min(duration, time));
    if (mediaType === "video" && userVideoEl && userVideoEl.src) {
      userVideoEl.currentTime = currentTime;
    } else if (mediaType === "audio" && userAudioEl && userAudioEl.src) {
      userAudioEl.currentTime = currentTime;
    }
    updateTimeUI();
    updateSubtitleOverlay();
  }

  seekbar?.addEventListener("input", () => {
    seekTo((Number(seekbar.value) / 100) * duration);
  });

  // Animation Loop
  function tick(timestamp: number) {
    if (!lastTimestamp) lastTimestamp = timestamp;
    const delta = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;

    if (isPlaying) {
      if (mediaType === "video" && userVideoEl && !userVideoEl.paused) {
        currentTime = userVideoEl.currentTime;
      } else if (mediaType === "audio" && userAudioEl && !userAudioEl.paused) {
        currentTime = userAudioEl.currentTime;
      } else if (mediaType === "none") {
        currentTime += delta;
        if (currentTime >= duration) {
          currentTime = 0;
        }
      }
      updateTimeUI();
    }

    if (mediaType !== "video") {
      drawCanvasFrame(timestamp);
    }
    updateSubtitleOverlay();

    animFrameId = requestAnimationFrame(tick);
  }

  function setPlayingState(playing: boolean) {
    isPlaying = playing;
    if (playIcon) playIcon.textContent = isPlaying ? "❚❚" : "▶";
    if (miniPlayBtn) miniPlayBtn.textContent = isPlaying ? "❚❚" : "▶";
  }

  function togglePlay() {
    if (mediaType === "video" && userVideoEl && userVideoEl.src) {
      if (userVideoEl.paused) {
        userVideoEl.play().then(() => setPlayingState(true)).catch(() => {});
      } else {
        userVideoEl.pause();
        setPlayingState(false);
      }
    } else if (mediaType === "audio" && userAudioEl && userAudioEl.src) {
      if (userAudioEl.paused) {
        if (audioContext && audioContext.state === "suspended") {
          audioContext.resume();
        }
        userAudioEl.play().then(() => setPlayingState(true)).catch(() => {});
      } else {
        userAudioEl.pause();
        setPlayingState(false);
      }
    } else {
      setPlayingState(!isPlaying);
    }
  }

  playBtn?.addEventListener("click", togglePlay);
  miniPlayBtn?.addEventListener("click", togglePlay);

  // Keyboard shortcut: Spacebar to Play/Pause
  window.addEventListener("keydown", (e) => {
    if (e.code === "Space" && e.target === document.body) {
      e.preventDefault();
      togglePlay();
    }
  });

  // Media Player Events
  userVideoEl?.addEventListener("play", () => setPlayingState(true));
  userVideoEl?.addEventListener("pause", () => setPlayingState(false));
  userVideoEl?.addEventListener("ended", () => {
    setPlayingState(false);
    currentTime = 0;
    userVideoEl.currentTime = 0;
    updateTimeUI();
  });
  userVideoEl?.addEventListener("timeupdate", () => {
    currentTime = userVideoEl.currentTime;
    updateTimeUI();
  });

  userAudioEl?.addEventListener("play", () => setPlayingState(true));
  userAudioEl?.addEventListener("pause", () => setPlayingState(false));
  userAudioEl?.addEventListener("ended", () => {
    setPlayingState(false);
    currentTime = 0;
    userAudioEl.currentTime = 0;
    updateTimeUI();
  });
  userAudioEl?.addEventListener("timeupdate", () => {
    currentTime = userAudioEl.currentTime;
    updateTimeUI();
  });

  // Speed Buttons
  document.querySelectorAll<HTMLButtonElement>(".speed-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const spd = Number(btn.dataset.speed || 1);
      if (userVideoEl) userVideoEl.playbackRate = spd;
      if (userAudioEl) userAudioEl.playbackRate = spd;
      document.querySelectorAll<HTMLButtonElement>(".speed-btn").forEach((b) => {
        const isMatch = b.dataset.speed === btn.dataset.speed;
        b.classList.toggle("bg-[var(--color-ink)]", isMatch);
        b.classList.toggle("text-[var(--color-on-primary)]", isMatch);
        b.classList.toggle("text-[var(--color-body)]", !isMatch);
      });
    });
  });

  // Volume Slider & Mute
  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement;
  const muteBtn = document.getElementById("mute-toggle-btn");
  volumeSlider?.addEventListener("input", () => {
    const vol = Number(volumeSlider.value);
    if (userVideoEl) userVideoEl.volume = vol;
    if (userAudioEl) userAudioEl.volume = vol;
    if (muteBtn) muteBtn.textContent = vol === 0 ? "🔇" : "🔊";
  });

  muteBtn?.addEventListener("click", () => {
    const isMuted = userVideoEl.muted || userAudioEl.muted;
    if (userVideoEl) userVideoEl.muted = !isMuted;
    if (userAudioEl) userAudioEl.muted = !isMuted;
    if (muteBtn) muteBtn.textContent = isMuted ? "🔊" : "🔇";
  });

  // Aspect Ratio Switcher
  const aspectBtns = document.querySelectorAll<HTMLButtonElement>(".aspect-btn");
  function setAspectRatio(ratio: string) {
    aspectBtns.forEach((b) => {
      const isMatch = b.dataset.ratio === ratio;
      b.classList.toggle("bg-[var(--color-canvas)]", isMatch);
      b.classList.toggle("text-[var(--color-ink)]", isMatch);
      b.classList.toggle("shadow-l1", isMatch);
      b.classList.toggle("text-[var(--color-mute)]", !isMatch);
    });

    if (viewport) {
      if (ratio === "16-9") {
        viewport.style.maxWidth = "520px";
        viewport.style.aspectRatio = "16 / 9";
      } else if (ratio === "1-1") {
        viewport.style.maxWidth = "380px";
        viewport.style.aspectRatio = "1 / 1";
      } else {
        viewport.style.maxWidth = "340px";
        viewport.style.aspectRatio = "9 / 16";
      }
    }
    setTimeout(resizeCanvas, 60);
  }

  aspectBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const ratio = btn.dataset.ratio || "9-16";
      setAspectRatio(ratio);
    });
