    const textarea = document.getElementById("script-textarea") as HTMLTextAreaElement;
    if (textarea) {
      textarea.value = "In this video, I will show you how to generate viral subtitles in under 60 seconds. You can customize colors, add active word animations, and export ready-to-publish subtitle files instantly.";
    }
  });

  document.getElementById("generate-script-cues-btn")?.addEventListener("click", () => {
    const textarea = document.getElementById("script-textarea") as HTMLTextAreaElement;
    const text = textarea?.value.trim();
    if (!text) {
      alert("Please paste or type your script text first.");
      return;
    }

    const wpm = Number(wpmSlider?.value || 160);
    const maxWordsPerLine = Number(wordsSlider?.value || 3);
    const words = text.split(/\s+/);
    const secPerWord = 60 / wpm;

    const newCues: SubtitleCue[] = [];
    let currentLineWords: string[] = [];
    let lineStartTime = 0;

    words.forEach((word, i) => {
      currentLineWords.push(word);
      const isLast = i === words.length - 1;
      const isPunctuation = /[.!?]$/.test(word);

      if (currentLineWords.length >= maxWordsPerLine || isPunctuation || isLast) {
        const lineDuration = currentLineWords.length * secPerWord;
        const lineEndTime = lineStartTime + Math.max(1.0, lineDuration);

        newCues.push({
          id: String(i),
          start: Number(lineStartTime.toFixed(1)),
          end: Number(lineEndTime.toFixed(1)),
          text: currentLineWords.join(" ").toUpperCase(),
        });

        lineStartTime = Number((lineEndTime + 0.15).toFixed(1));
        currentLineWords = [];
      }
    });

    currentCues = newCues;
    duration = Math.max(10, Math.ceil(newCues[newCues.length - 1].end + 1));
    renderCuesTable();
    updateTimeUI();
    switchTab("editor");
  });

  // Render Cues Table
  function renderCuesTable() {
    if (!cuesContainer) return;
    cuesContainer.innerHTML = "";

    currentCues.forEach((cue, index) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center gap-2 p-2.5 text-xs hover:bg-[var(--color-canvas-soft)] transition-colors group";
      row.dataset.cueId = cue.id;
      row.innerHTML = `
        <button class="cue-jump-btn shrink-0 w-6 h-6 rounded bg-[var(--color-canvas-soft-2)] hover:bg-[var(--color-ink)] hover:text-[var(--color-on-primary)] font-mono font-bold text-[10px] flex items-center justify-center transition-colors cursor-pointer" title="Jump to timestamp">
          ${index + 1}
        </button>
        <input
          type="number"
          step="0.1"
          class="cue-start-input w-14 px-1.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-mono text-center focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.start.toFixed(1)}"
          aria-label="Start time in seconds"
        />
        <span class="text-[var(--color-mute)] text-[10px]">→</span>
        <input
          type="number"
          step="0.1"
          class="cue-end-input w-14 px-1.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-mono text-center focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.end.toFixed(1)}"
          aria-label="End time in seconds"
        />
        <input
          type="text"
          class="cue-text-input flex-1 px-2.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-medium focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.text}"
          aria-label="Subtitle cue text"
        />
        <button class="cue-delete-btn text-[var(--color-mute)] hover:text-[var(--color-error)] px-2 py-1 rounded text-sm transition-colors cursor-pointer" title="Delete line">
          ✕
        </button>
      `;

      row.querySelector(".cue-jump-btn")?.addEventListener("click", () => {
        seekTo(cue.start);
      });

      row.querySelector(".cue-start-input")?.addEventListener("change", (e) => {
        cue.start = Number((e.target as HTMLInputElement).value);
      });

      row.querySelector(".cue-end-input")?.addEventListener("change", (e) => {
        cue.end = Number((e.target as HTMLInputElement).value);
      });

      row.querySelector(".cue-text-input")?.addEventListener("input", (e) => {
        cue.text = (e.target as HTMLInputElement).value;
        lastRenderedCueId = "";
        updateSubtitleOverlay();
      });

      row.querySelector(".cue-delete-btn")?.addEventListener("click", () => {
        currentCues = currentCues.filter((c) => c.id !== cue.id);
        renderCuesTable();
        lastRenderedCueId = "";
        updateSubtitleOverlay();
      });

      cuesContainer.appendChild(row);
    });

    if (cueCountBadge) cueCountBadge.textContent = `${currentCues.length} cues`;
    if (currentCues.length > 0) {
      const maxEnd = currentCues[currentCues.length - 1].end;
      if (!isCustomMediaLoaded) {
        duration = Math.max(10, Math.ceil(maxEnd + 1));
        updateTimeUI();
      }
    }
  }

  // Add Cue Button
  document.getElementById("add-cue-btn")?.addEventListener("click", () => {
    const lastEnd = currentCues.length > 0 ? currentCues[currentCues.length - 1].end : 0;
    currentCues.push({
      id: String(Date.now()),
      start: Number((lastEnd + 0.2).toFixed(1)),
      end: Number((lastEnd + 2.5).toFixed(1)),
      text: "NEW VIRAL SUBTITLE LINE 🔥",
    });
    renderCuesTable();
  });

  // ─── Export Generators ──────────────────────────────────────
  function formatSrtTimestamp(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    const ms = Math.floor((seconds % 1) * 1000);
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")},${String(ms).padStart(3, "0")}`;
  }

  function formatVttTimestamp(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    const ms = Math.floor((seconds % 1) * 1000);
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}.${String(ms).padStart(3, "0")}`;
  }

  function downloadFile(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Download .SRT
  document.getElementById("export-srt-btn")?.addEventListener("click", () => {
    let srtText = "";
    currentCues.forEach((cue, i) => {
      srtText += `${i + 1}\n`;
      srtText += `${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}\n`;
      srtText += `${cue.text}\n\n`;
    });
    downloadFile(srtText, "subtitles.srt", "text/plain");
  });

  // Download .VTT
  document.getElementById("export-vtt-btn")?.addEventListener("click", () => {
    let vttText = "WEBVTT\n\n";
    currentCues.forEach((cue, i) => {
      vttText += `${i + 1}\n`;
      vttText += `${formatVttTimestamp(cue.start)} --> ${formatVttTimestamp(cue.end)}\n`;
      vttText += `${cue.text}\n\n`;
    });
    downloadFile(vttText, "subtitles.vtt", "text/vtt");
  });

  // Download .TXT
  document.getElementById("export-txt-btn")?.addEventListener("click", () => {
    const txtContent = currentCues.map((c) => c.text).join("\n");
    downloadFile(txtContent, "transcript.txt", "text/plain");
  });

  // Copy to Clipboard
  document.getElementById("copy-all-btn")?.addEventListener("click", async () => {
    let srtText = "";
    currentCues.forEach((cue, i) => {
      srtText += `${i + 1}\n${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}\n${cue.text}\n\n`;
    });
    try {
      await navigator.clipboard.writeText(srtText);
      const btn = document.getElementById("copy-all-btn");
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = "✓ Copied!";
        setTimeout(() => {
          btn.textContent = orig;
        }, 2000);
      }
    } catch (_) {}
  });

  // ─── Burn Subtitles to Video Export Engine ───────────────────
  const burnVideoBtn = document.getElementById("burn-video-btn");
  const burnVideoLabel = document.getElementById("burn-video-label");

  burnVideoBtn?.addEventListener("click", async () => {
    if (!canvas) return;

    const hasVideo = mediaType === "video" && userVideoEl && userVideoEl.src;
    if (burnVideoLabel) burnVideoLabel.textContent = "Rendering Video... (Please wait)";
    burnVideoBtn.setAttribute("disabled", "true");

    const recordCanvas = document.createElement("canvas");
    recordCanvas.width = hasVideo && userVideoEl.videoWidth ? userVideoEl.videoWidth : 720;
    recordCanvas.height = hasVideo && userVideoEl.videoHeight ? userVideoEl.videoHeight : 1280;
    const rctx = recordCanvas.getContext("2d");
    if (!rctx) return;

    const stream = recordCanvas.captureStream(30);
    let mediaRecorder: MediaRecorder;
    try {
      mediaRecorder = new MediaRecorder(stream, { mimeType: "video/webm;codecs=vp9" });
    } catch (_) {
      try {
        mediaRecorder = new MediaRecorder(stream, { mimeType: "video/webm" });
      } catch (_) {
        mediaRecorder = new MediaRecorder(stream);
      }
    }

    const chunks: Blob[] = [];
    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) chunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: "video/webm" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "video_with_animated_subtitles.webm";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (burnVideoLabel) burnVideoLabel.textContent = "✓ Video Downloaded!";
      setTimeout(() => {
        if (burnVideoLabel) burnVideoLabel.textContent = "Download Video with Subtitles";
        burnVideoBtn.removeAttribute("disabled");
      }, 3000);
    };

    mediaRecorder.start();

    let renderTime = 0;
    const renderDuration = Math.min(15, duration);
    const fps = 30;
    const frameInterval = 1000 / fps;

    if (hasVideo) {
      userVideoEl.currentTime = 0;
      userVideoEl.play().catch(() => {});
    }

    const renderInterval = setInterval(() => {
      renderTime += 1 / fps;

      // Draw background video frame or canvas
      if (hasVideo && userVideoEl.videoWidth) {
        rctx.drawImage(userVideoEl, 0, 0, recordCanvas.width, recordCanvas.height);
      } else {
        rctx.drawImage(canvas, 0, 0, recordCanvas.width, recordCanvas.height);
      }

      // Draw active subtitle overlay
      const activeCue = currentCues.find((c) => renderTime >= c.start && renderTime <= c.end);
      if (activeCue) {
        rctx.save();
        const posPercent = Number(posSlider?.value || 18) / 100;
        const textY = recordCanvas.height * (1 - posPercent);
        const fontSize = Math.round((Number(fontSlider?.value || 24) / 340) * recordCanvas.width);

        rctx.font = `900 ${fontSize}px 'Outfit', Inter, sans-serif`;
        rctx.textAlign = "center";
        rctx.textBaseline = "middle";

        // Draw outline / shadow
        rctx.strokeStyle = "#000000";
        rctx.lineWidth = Math.max(4, Math.round(fontSize * 0.18));
        rctx.strokeText(activeCue.text, recordCanvas.width / 2, textY);

        // Fill active color
        rctx.fillStyle = activeColor || "#facc15";
        rctx.fillText(activeCue.text, recordCanvas.width / 2, textY);
        rctx.restore();
      }

      if (renderTime >= renderDuration) {
        clearInterval(renderInterval);
        if (hasVideo) userVideoEl.pause();
        mediaRecorder.stop();
      }
    }, frameInterval);
  });

  // Initial setup
  renderCuesTable();
  animFrameId = requestAnimationFrame(tick);
</script>
