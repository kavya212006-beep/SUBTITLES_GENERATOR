                <button
                  id="inject-emojis-btn"
                  class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:border-[var(--color-link)] hover:text-[var(--color-link)] transition-all cursor-pointer"
                  title="Auto-inject viral emojis into subtitles"
