  // Download .TXT
  document.getElementById('export-txt-btn')?.addEventListener('click', () => {
    const txtContent = currentCues.map(c => c.text).join('\n');
    downloadFile(txtContent, 'transcript.txt', 'text/plain');
  });

  // Copy to Clipboard
  document.getElementById('copy-all-btn')?.addEventListener('click', async () => {
    let srtText = '';
    currentCues.forEach((cue, i) => {
      srtText += `${i + 1}\n${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}\n${cue.text}\n\n`;
    });
    try {
      await navigator.clipboard.writeText(srtText);
      const btn = document.getElementById('copy-all-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = orig; }, 2000);
      }
    } catch (_) {}
  });

  // Custom Video File Upload in Editor Viewport
  const customVideoInput = document.getElementById('custom-video-input') as HTMLInputElement;
  customVideoInput?.addEventListener('change', () => {
    const file = customVideoInput.files?.[0];
    if (file) {
      const url = URL.createObjectURL(file);
      const userVideoEl = document.getElementById('user-video') as HTMLVideoElement;
      const motionCanvas = document.getElementById('motion-canvas');
      if (userVideoEl && motionCanvas) {
        userVideoEl.src = url;
        userVideoEl.classList.remove('hidden');
        motionCanvas.classList.add('hidden');
        userVideoEl.onloadedmetadata = () => {
          duration = Math.max(5, Math.ceil(userVideoEl.duration));
          updateTimeUI();
        };
      }
    }
  });

  // Burn Subtitles to Video Export Engine (MediaRecorder API)
  const burnVideoBtn = document.getElementById('burn-video-btn');
  const burnVideoLabel = document.getElementById('burn-video-label');

  burnVideoBtn?.addEventListener('click', async () => {
    if (!canvas) return;

    const userVideoEl = document.getElementById('user-video') as HTMLVideoElement;
    const hasCustomVideo = userVideoEl && !userVideoEl.classList.contains('hidden') && userVideoEl.src;

    if (burnVideoLabel) burnVideoLabel.textContent = "Rendering Video... (Please wait)";
    burnVideoBtn.setAttribute('disabled', 'true');

    // Create offscreen recording canvas
    const recordCanvas = document.createElement('canvas');
    recordCanvas.width = canvas.width || 720;
    recordCanvas.height = canvas.height || 1280;
    const rctx = recordCanvas.getContext('2d');
    if (!rctx) return;

    const stream = recordCanvas.captureStream(30);
    let mediaRecorder: MediaRecorder;
    try {
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp9' });
    } catch (_) {
      mediaRecorder = new MediaRecorder(stream);
    }

    const chunks: Blob[] = [];
    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) chunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'video_with_subtitles.webm';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (burnVideoLabel) burnVideoLabel.textContent = "✓ Video Downloaded!";
      setTimeout(() => {
        if (burnVideoLabel) burnVideoLabel.textContent = "Download Video with Subtitles";
        burnVideoBtn.removeAttribute('disabled');
      }, 3000);
    };

    mediaRecorder.start();

    // Render 5 seconds of video with subtitles into the recorder canvas
    let renderTime = 0;
    const renderDuration = Math.min(10, duration);
    const fps = 30;
    const frameInterval = 1000 / fps;

    const renderInterval = setInterval(() => {
      renderTime += 1 / fps;

      // Draw background: custom video frame or simulated motion canvas
      if (hasCustomVideo && userVideoEl.videoWidth) {
        rctx.drawImage(userVideoEl, 0, 0, recordCanvas.width, recordCanvas.height);
      } else {
        rctx.drawImage(canvas, 0, 0, recordCanvas.width, recordCanvas.height);
      }

      // Draw subtitle overlay
      const activeCue = currentCues.find(c => renderTime >= c.start && renderTime <= c.end);
      if (activeCue) {
        rctx.save();
        rctx.font = "bold 28px 'Outfit', Inter, sans-serif";
        rctx.textAlign = "center";
        rctx.textBaseline = "middle";

        const textY = recordCanvas.height * 0.85;

        // Black outline
        rctx.strokeStyle = "#000000";
        rctx.lineWidth = 6;
        rctx.strokeText(activeCue.text, recordCanvas.width / 2, textY);

        // Highlight color
        rctx.fillStyle = currentStyle === 'hormozi' ? '#facc15' : currentStyle === 'beast' ? '#38bdf8' : '#ffffff';
        rctx.fillText(activeCue.text, recordCanvas.width / 2, textY);
        rctx.restore();
      }

      if (renderTime >= renderDuration) {
        clearInterval(renderInterval);
        mediaRecorder.stop();
      }
    }, frameInterval);
  });

  // Init
  renderCuesTable();
  animFrameId = requestAnimationFrame(tick);
</script>
