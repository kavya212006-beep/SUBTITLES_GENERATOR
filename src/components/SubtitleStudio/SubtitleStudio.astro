          value="${cue.text}"
          aria-label="Subtitle cue text"
        />
        <button class="cue-delete-btn text-[var(--color-mute)] hover:text-[var(--color-error)] px-2 py-1 rounded text-sm transition-colors" title="Delete line">
          ✕
        </button>
      `;

      // Event listeners for cue row
      row.querySelector('.cue-jump-btn')?.addEventListener('click', () => {
        currentTime = cue.start;
        updateTimeUI();
        updateSubtitleOverlay();
      });

      row.querySelector('.cue-start-input')?.addEventListener('change', (e) => {
        cue.start = Number((e.target as HTMLInputElement).value);
