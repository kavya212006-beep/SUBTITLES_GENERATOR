              <!-- Font Size Slider -->
              <div class="flex flex-col gap-1.5">
                <div class="flex justify-between items-center text-xs font-semibold">
                  <span class="text-[var(--color-body)]">{t(lang, "editor.fontSize")}</span>
                  <span id="fontsize-label" class="font-mono text-[var(--color-ink)]">24px</span>
                </div>
                <input
                  id="fontsize-slider"
                  type="range"
                  min="16"
                  max="44"
                  value="24"
                  class="w-full accent-[var(--color-link)] cursor-pointer"
                />
              </div>
            </div>
          </div>

          <!-- Timeline & Cue Table Header -->
          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center gap-2">
              <h4
                class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink)]"
              >
                {t(lang, "timeline.title")}
              </h4>
              <span
                id="cue-count-badge"
                class="px-2 py-0.5 text-xs rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-mute)] font-mono"
