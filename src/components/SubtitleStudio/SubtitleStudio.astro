---
import { t } from '../../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylePresets = [
  { id: 'hormozi', nameKey: 'styles.hormozi', icon: '🔥', desc: 'Bold yellow pop, high-energy retention' },
  { id: 'beast', nameKey: 'styles.beast', icon: '⚡', desc: 'Thick black stroke with cyan bounce' },
  { id: 'cinematic', nameKey: 'styles.cinematic', icon: '🎬', desc: 'Frosted dark pill box for film & docs' },
  { id: 'neon', nameKey: 'styles.neon', icon: '💜', desc: 'Cyberpunk glowing cyan & pink' },
  { id: 'karaoke', nameKey: 'styles.karaoke', icon: '🎤', desc: 'Smooth green progressive highlight' },
  { id: 'minimal', nameKey: 'styles.minimal', icon: '✨', desc: 'Clean modern typography' },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-8">

  <!-- ─── Studio Main Card ─────────────────────────────────── -->
  <div class="bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden">

    <!-- Top Workflow Tabs Bar -->
    <div class="flex items-center border-b border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] px-4 pt-3 overflow-x-auto scrollbar-hide" role="tablist">
      <button
        id="tab-btn-audio"
        role="tab"
        aria-selected="true"
        aria-controls="panel-audio"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 border-[var(--color-ink)] text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎙️</span>
        <span>{t(lang, 'studio.tab.audio')}</span>
      </button>
      <button
        id="tab-btn-script"
        role="tab"
        aria-selected="false"
        aria-controls="panel-script"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>📝</span>
        <span>{t(lang, 'studio.tab.script')}</span>
      </button>
      <button
        id="tab-btn-editor"
        role="tab"
        aria-selected="false"
        aria-controls="panel-editor"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎬</span>
        <span>{t(lang, 'studio.tab.editor')}</span>
        <span class="ms-1 px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-md bg-[var(--color-link-bg-soft)] text-[var(--color-link)]">Live</span>
      </button>
    </div>

    <!-- ─── TAB 1: Audio / Video Transcriber ─────────────────── -->
    <div id="panel-audio" role="tabpanel" class="p-6 md:p-8 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'studio.tab.audio')}</h3>
        <p class="text-sm text-[var(--color-body)]">{t(lang, 'audio.drop.formats')}</p>
      </div>

      <!-- Drag & Drop Upload Zone -->
      <label
        id="audio-dropzone"
        for="media-file-input"
        class="flex flex-col items-center justify-center gap-4 w-full min-h-[220px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)] rounded-2xl cursor-pointer transition-all group relative bg-[var(--color-canvas-soft)]"
      >
        <div class="w-16 h-16 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
          🎙️
        </div>
        <div class="text-center">
          <p class="text-base font-semibold text-[var(--color-ink)]">{t(lang, 'audio.drop.title')}</p>
          <p class="text-xs text-[var(--color-mute)] mt-1">{t(lang, 'audio.drop.subtitle')}</p>
        </div>

        <input
          id="media-file-input"
          type="file"
          accept="audio/*,video/*"
          class="sr-only"
        />

        <!-- Loading Overlay -->
        <div id="transcribe-loading" class="hidden absolute inset-0 bg-[var(--color-canvas)]/90 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center gap-4 z-20">
          <div class="flex items-center gap-1.5 h-8">
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-1"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-2"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-3"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-4"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-5"></div>
          </div>
          <p class="text-sm font-medium text-[var(--color-ink)] animate-pulse">{t(lang, 'audio.analyzing')}</p>
        </div>
      </label>

      <!-- Live Voice AI Recording & Demo Samples -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider">{t(lang, 'audio.sample.heading')}</span>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="podcast">
            {t(lang, 'audio.sample.podcast')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="motivation">
            {t(lang, 'audio.sample.motivation')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="tutorial">
            {t(lang, 'audio.sample.tutorial')}
          </button>
        </div>

        <!-- Live Speech Recognition Button -->
        <button
          id="live-speech-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-all shadow-l1 shrink-0"
        >
          <span id="mic-icon">🎙️</span>
          <span id="mic-label">Record Voice (Live AI Transcribe)</span>
          <span id="mic-pulse" class="hidden w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
        </button>
      </div>

      <!-- Free AI Model Info Banner -->
      <div class="p-3.5 rounded-xl bg-[var(--color-link-bg-soft)] border border-[var(--color-link)]/20 flex items-start gap-2.5 text-xs text-[var(--color-ink)]">
        <span class="text-base shrink-0">✨</span>
        <div class="flex flex-col gap-0.5">
          <span class="font-bold">100% Free & Unlimited In-Browser AI Engine</span>
          <span class="text-[var(--color-body)]">Our speech-to-text uses free open-source Web Speech AI and client-side acoustic modeling. No subscriptions, no API fees, and your media files never leave your device.</span>
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: Script to Subtitle Synchronizer ───────────── -->
    <div id="panel-script" role="tabpanel" class="hidden p-6 md:p-8 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'script.title')}</h3>
        <p class="text-sm text-[var(--color-body)]">{t(lang, 'script.subtitle')}</p>
      </div>

      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <label for="script-textarea" class="text-xs font-semibold uppercase tracking-wider text-[var(--color-mute)]">Raw Transcript / Dialogue</label>
          <button id="insert-sample-script" class="text-xs font-medium text-[var(--color-link)] hover:underline">
            {t(lang, 'script.sampleBtn')}
          </button>
        </div>
        <textarea
          id="script-textarea"
          rows="6"
          class="w-full p-4 text-sm rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-[var(--color-ink)] focus:outline-none focus:ring-2 focus:ring-[var(--color-link)] focus:ring-offset-1 font-sans transition-all placeholder:text-[var(--color-mute)]"
          placeholder={t(lang, 'script.placeholder')}
        ></textarea>
      </div>

      <!-- Pacing Controls -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
        <div class="flex flex-col gap-2">
          <div class="flex justify-between items-center text-xs font-medium">
            <span class="text-[var(--color-body)]">{t(lang, 'script.wpm')}</span>
            <span id="wpm-val" class="font-mono text-[var(--color-ink)] font-bold">160 WPM</span>
          </div>
          <input
            id="wpm-slider"
            type="range"
            min="100"
            max="260"
            step="10"
            value="160"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
          <span class="text-[11px] text-[var(--color-mute)]">Standard conversational speaking pace is ~150-170 WPM.</span>
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex justify-between items-center text-xs font-medium">
            <span class="text-[var(--color-body)]">{t(lang, 'script.wordsPerLine')}</span>
            <span id="words-val" class="font-mono text-[var(--color-ink)] font-bold">4 words</span>
          </div>
          <input
            id="words-slider"
            type="range"
            min="2"
            max="8"
            step="1"
            value="4"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
          <span class="text-[11px] text-[var(--color-mute)]">Shorter lines (3-5 words) achieve highest retention on Reels & TikTok.</span>
        </div>
      </div>

      <button
        id="generate-script-cues-btn"
        class="inline-flex items-center justify-center gap-2 h-12 px-6 text-sm font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l2 self-start"
      >
        <span>⚡</span>
        <span>{t(lang, 'script.generateBtn')}</span>
      </button>
    </div>

    <!-- ─── TAB 3: Live Video Studio & Editor ────────────────── -->
    <div id="panel-editor" role="tabpanel" class="hidden p-6 md:p-8 flex flex-col gap-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Video Player & Subtitle Canvas (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <label for="custom-video-input" class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all cursor-pointer">
              <span>📁</span>
              <span>Upload Video</span>
              <input id="custom-video-input" type="file" accept="video/*" class="sr-only" />
            </label>
            <!-- Aspect Ratio Switcher -->
            <div class="flex items-center gap-1 bg-[var(--color-canvas-soft)] p-1 rounded-lg border border-[var(--color-hairline)] text-xs">
              <button class="aspect-btn px-2 py-1 rounded font-medium bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-l1" data-ratio="9-16">9:16</button>
              <button class="aspect-btn px-2 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]" data-ratio="16-9">16:9</button>
              <button class="aspect-btn px-2 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]" data-ratio="1-1">1:1</button>
            </div>
          </div>

          <!-- Video Container Box -->
          <div
            id="video-viewport"
            class="relative w-full max-w-[340px] mx-auto aspect-[9/16] bg-zinc-950 rounded-2xl overflow-hidden shadow-2xl border border-[var(--color-hairline)] flex items-center justify-center select-none group"
          >
            <!-- Canvas Animated Background Generator (Simulated Video) -->
            <canvas id="motion-canvas" class="w-full h-full object-cover"></canvas>
            
            <!-- User HTML5 Video Tag (if video file loaded) -->
            <video id="user-video" class="hidden w-full h-full object-cover" playsinline loop></video>

            <!-- Subtitle Overlay Overlay Container -->
            <div
              id="subtitle-overlay-box"
              class="absolute left-4 right-4 pointer-events-none transition-all flex justify-center text-center bottom-[15%]"
            >
              <div
                id="subtitle-rendered-text"
                class="sub-style-hormozi text-2xl font-bold tracking-tight text-center max-w-full px-2 py-1 leading-snug transition-transform"
              >
                <!-- Words injected dynamically by JS -->
                GENERATE <span class="word-active">VIRAL</span> SUBTITLES
              </div>
            </div>

            <!-- Big Play/Pause Button on Hover -->
            <button
              id="video-play-btn"
              class="absolute w-14 h-14 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center text-xl hover:scale-110 transition-transform shadow-lg group-hover:opacity-100 opacity-80"
              aria-label="Play or pause video preview"
            >
              <span id="play-icon">▶</span>
            </button>
          </div>

          <!-- Player Controls Bar -->
          <div class="flex flex-col gap-2 p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
            <div class="flex items-center gap-3">
              <button id="mini-play-btn" class="w-8 h-8 rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs text-[var(--color-ink)] flex items-center justify-center font-bold">
                ▶
              </button>
              <input
                id="video-seekbar"
                type="range"
                min="0"
                max="100"
                value="0"
                step="0.1"
                class="flex-1 accent-[var(--color-link)] cursor-pointer"
              />
              <span id="time-display" class="font-mono text-xs font-medium text-[var(--color-mute)]">00:00 / 00:15</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Style Preset Selector & Position Controls (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">

          <!-- Style Preset Cards Grid -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink)]">{t(lang, 'styles.title')}</h4>
              <span class="text-xs text-[var(--color-mute)]">Click any style to preview instantly</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="style-presets-grid">
              {stylePresets.map((preset, idx) => (
                <button
                  class:list={[
                    'style-preset-btn p-3.5 rounded-xl border text-start flex items-start gap-3 transition-all cursor-pointer',
                    idx === 0
                      ? 'border-[var(--color-link)] bg-[var(--color-link-bg-soft)] ring-2 ring-[var(--color-link)]/20'
                      : 'border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:border-[var(--color-hairline-strong)]'
                  ]}
                  data-style={preset.id}
                >
                  <span class="text-2xl shrink-0" aria-hidden="true">{preset.icon}</span>
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-[var(--color-ink)]">{t(lang, preset.nameKey as any)}</span>
                    <span class="text-xs text-[var(--color-mute)] mt-0.5 leading-snug">{preset.desc}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <!-- Position & Font Controls -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
            <div class="flex flex-col gap-2">
              <span class="text-xs font-semibold text-[var(--color-body)]">{t(lang, 'editor.position')}</span>
              <div class="flex gap-1">
                <button class="pos-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)]" data-pos="top">{t(lang, 'editor.posTop')}</button>
                <button class="pos-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)]" data-pos="center">{t(lang, 'editor.posCenter')}</button>
                <button class="pos-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-link)] bg-[var(--color-ink)] text-[var(--color-on-primary)]" data-pos="bottom">{t(lang, 'editor.posBottom')}</button>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-center text-xs font-semibold">
                <span class="text-[var(--color-body)]">{t(lang, 'editor.fontSize')}</span>
                <span id="fontsize-label" class="font-mono text-[var(--color-ink)]">24px</span>
              </div>
              <input
                id="fontsize-slider"
                type="range"
                min="16"
                max="40"
                value="24"
                class="w-full accent-[var(--color-link)] cursor-pointer"
              />
            </div>
          </div>

          <!-- Timeline & Cue Table Header -->
          <div class="flex items-center justify-between pt-2">
            <div class="flex items-center gap-2">
              <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink)]">{t(lang, 'timeline.title')}</h4>
              <span id="cue-count-badge" class="px-2 py-0.5 text-xs rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-mute)] font-mono">6 cues</span>
            </div>
            <button id="add-cue-btn" class="text-xs font-medium text-[var(--color-link)] hover:underline flex items-center gap-1">
              {t(lang, 'timeline.add')}
            </button>
          </div>

          <!-- Editable Cues Table Container -->
          <div class="max-h-[280px] overflow-y-auto rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] divide-y divide-[var(--color-hairline)] shadow-l1" id="cues-container">
            <!-- Cues rendered by JS -->
          </div>

        </div>

      </div>

      <!-- ─── Export Action Bar ─────────────────────────────── -->
      <div class="pt-6 border-t border-[var(--color-hairline)] flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-col">
          <span class="text-sm font-bold text-[var(--color-ink)]">{t(lang, 'export.title')}</span>
          <span class="text-xs text-[var(--color-mute)]">Universal formats ready for YouTube, TikTok, Reels, Premiere Pro & CapCut</span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button id="burn-video-btn" class="h-10 px-5 text-xs font-semibold rounded-pill bg-gradient-to-r from-[var(--color-link)] to-[var(--color-violet)] text-white hover:opacity-90 transition-all shadow-l2 flex items-center gap-2">
            <span>🎬</span>
            <span id="burn-video-label">Download Video with Subtitles</span>
          </button>
          <button id="export-srt-btn" class="h-10 px-4 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l1 flex items-center gap-1.5">
            <span>📥</span>
            <span>{t(lang, 'export.srt')}</span>
          </button>
          <button id="export-vtt-btn" class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all flex items-center gap-1.5">
            <span>📄</span>
            <span>{t(lang, 'export.vtt')}</span>
          </button>
          <button id="export-txt-btn" class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all flex items-center gap-1.5">
            <span>📝</span>
            <span>{t(lang, 'export.txt')}</span>
          </button>
          <button id="copy-all-btn" class="h-10 px-4 text-xs font-semibold rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">
            {t(lang, 'export.copy')}
          </button>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- ─── Client Script Engine ───────────────────────────────── -->
<script>
  interface SubtitleCue {
    id: string;
    start: number; // in seconds
    end: number;
    text: string;
  }

  // Preloaded Demo Samples
  const demoSamples: Record<string, SubtitleCue[]> = {
    podcast: [
      { id: '1', start: 0.0, end: 2.2, text: "WELCOME BACK TO THE PODCAST" },
      { id: '2', start: 2.3, end: 4.8, text: "TODAY WE EXPLORE GENERATIVE AI" },
      { id: '3', start: 4.9, end: 7.4, text: "HOW CREATORS ARE SCALING 10X" },
      { id: '4', start: 7.5, end: 9.8, text: "WITH AUTOMATED VIDEO SUBTITLES" },
      { id: '5', start: 9.9, end: 12.0, text: "AND ZERO MANUAL EDITING EFFORT" },
    ],
    motivation: [
      { id: '1', start: 0.0, end: 2.5, text: "IF YOU WANT WHAT ONLY ONE PERCENT HAVE" },
      { id: '2', start: 2.6, end: 5.5, text: "YOU MUST DO WHAT NINETY NINE PERCENT WON'T" },
      { id: '3', start: 5.6, end: 8.8, text: "FOCUS EVERY SINGLE DAY ON YOUR GOALS" },
      { id: '4', start: 8.9, end: 12.0, text: "BECAUSE CONSISTENCY ALWAYS BEATS TALENT" },
      { id: '5', start: 12.1, end: 15.0, text: "START CREATING YOUR FUTURE TODAY" },
    ],
    tutorial: [
      { id: '1', start: 0.0, end: 2.4, text: "IN THIS QUICK CODING TUTORIAL" },
      { id: '2', start: 2.5, end: 5.0, text: "WE WILL CONNECT OUR WEB APPLICATION" },
      { id: '3', start: 5.1, end: 7.5, text: "DIRECTLY TO AN AI SPEECH ENGINE" },
      { id: '4', start: 7.6, end: 10.0, text: "TO GENERATE ACCURATE SUBTITLES FAST" },
    ]
  };

  // State
  let currentCues: SubtitleCue[] = [...demoSamples.motivation];
  let currentStyle = 'hormozi';
  let isPlaying = false;
  let currentTime = 0;
  let duration = 15.0;
  let animFrameId: number | null = null;
  let lastTimestamp = 0;

  // DOM Elements
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.studio-tab-btn');
  const panels = {
    audio: document.getElementById('panel-audio'),
    script: document.getElementById('panel-script'),
    editor: document.getElementById('panel-editor'),
  };

