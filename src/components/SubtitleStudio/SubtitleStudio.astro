  // ─── Probing Media Duration & Dimensions Accurately ──────────
  function probeMediaDuration(mediaEl: HTMLMediaElement): Promise<number> {
    return new Promise((resolve) => {
      if (isFinite(mediaEl.duration) && mediaEl.duration > 0 && mediaEl.duration !== Infinity) {
        return resolve(mediaEl.duration);
      }

      let resolved = false;
      const done = (dur: number) => {
        if (!resolved) {
          resolved = true;
          cleanup();
          resolve(dur > 0 && isFinite(dur) ? dur : 10);
        }
      };

      const checkDuration = () => {
        if (isFinite(mediaEl.duration) && mediaEl.duration > 0 && mediaEl.duration !== Infinity) {
          done(mediaEl.duration);
          return true;
        }
        return false;
      };

      const seekToEnd = () => {
        const onSeeked = () => {
          mediaEl.removeEventListener("seeked", onSeeked);
          const dur = isFinite(mediaEl.currentTime) && mediaEl.currentTime > 0 ? mediaEl.currentTime : (isFinite(mediaEl.duration) && mediaEl.duration > 0 ? mediaEl.duration : 10);
          mediaEl.currentTime = 0;
          done(dur);
        };
        mediaEl.addEventListener("seeked", onSeeked, { once: true });
        try {
          mediaEl.currentTime = 1e101;
        } catch (_) {
          done(10);
        }
      };

      const onMetadata = () => {
        if (!checkDuration()) {
          seekToEnd();
        }
      };

      const onCanPlay = () => {
        if (!checkDuration()) {
          seekToEnd();
        }
      };

      const onError = () => done(10);

      const cleanup = () => {
        mediaEl.removeEventListener("loadedmetadata", onMetadata);
        mediaEl.removeEventListener("loadeddata", onMetadata);
        mediaEl.removeEventListener("durationchange", onMetadata);
        mediaEl.removeEventListener("canplay", onCanPlay);
        mediaEl.removeEventListener("error", onError);
      };

      mediaEl.addEventListener("loadedmetadata", onMetadata, { once: true });
      mediaEl.addEventListener("loadeddata", onMetadata, { once: true });
      mediaEl.addEventListener("durationchange", onMetadata, { once: true });
      mediaEl.addEventListener("canplay", onCanPlay, { once: true });
      mediaEl.addEventListener("error", onError, { once: true });

      // Fallback timeout in case browser never fires metadata
      setTimeout(() => {
        if (!resolved) {
          const finalDur = isFinite(mediaEl.duration) && mediaEl.duration > 0 ? mediaEl.duration : (isFinite(mediaEl.currentTime) && mediaEl.currentTime > 0 ? mediaEl.currentTime : 10);
          done(finalDur);
        }
      }, 3500);
    });
  }

  // ─── Fast In-Memory WAV Encoder for AI Pipeline ─────────────
  function encodeAudioToWav(samples: Float32Array, sampleRate: number = 16000): Blob {
    const buffer = new ArrayBuffer(44 + samples.length * 2);
    const view = new DataView(buffer);

    const writeString = (offset: number, str: string) => {
      for (let i = 0; i < str.length; i++) {
        view.setUint8(offset + i, str.charCodeAt(i));
      }
    };

    writeString(0, "RIFF");
    view.setUint32(4, 36 + samples.length * 2, true);
    writeString(8, "WAVE");
    writeString(12, "fmt ");
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true); // PCM format
    view.setUint16(22, 1, true); // Mono
    view.setUint32(24, sampleRate, true);
    view.setUint32(28, sampleRate * 2, true);
    view.setUint16(32, 2, true); // block align
    view.setUint16(34, 16, true); // 16-bit
    writeString(36, "data");
    view.setUint32(40, samples.length * 2, true);

    let offset = 44;
    for (let i = 0; i < samples.length; i++, offset += 2) {
      const s = Math.max(-1, Math.min(1, samples[i]));
      view.setInt16(offset, s < 0 ? s * 0x8000 : s * 0x7fff, true);
    }

    return new Blob([view], { type: "audio/wav" });
  }

  // ─── AI Speech-to-Text & Audio Extraction Engine ────────────
  let whisperPipeline: any = null;
  let currentWhisperModel: string | null = null;

  async function getWhisperPipeline(
    selectedLang: string = "auto",
    onProgress?: (progress: number, text: string) => void
  ) {
    const isEnglishOnly = selectedLang === "en-US" || selectedLang === "en-GB" || selectedLang === "en-IN" || selectedLang === "en";
    const targetModel = isEnglishOnly ? "Xenova/whisper-tiny.en" : "Xenova/whisper-tiny";

    if (whisperPipeline && currentWhisperModel === targetModel) {
      console.log(`[SubStudio] [Pipeline] Reusing cached Whisper pipeline (${targetModel})`);
      return whisperPipeline;
    }

    try {
      onProgress?.(30, "Initializing on-device AI transcription engine...");
      console.log(`[SubStudio] [Pipeline] Loading Transformers.js pipeline for model: ${targetModel}...`);
      const { pipeline, env } = await import("https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2");
      
      env.allowLocalModels = false;
      env.allowRemoteModels = true;
      env.useBrowserCache = true;
      env.backends.onnx.wasm.numThreads = 1;
      env.remoteHost = "https://huggingface.co";
      env.remotePathTemplate = "{model}/resolve/{revision}/";
      env.backends.onnx.wasm.wasmPaths = "https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2/dist/";
      
      whisperPipeline = await pipeline("automatic-speech-recognition", targetModel, {
        quantized: true,
        progress_callback: (p: any) => {
          if (p.status === "progress" && p.total) {
            const pct = Math.round(30 + ((p.loaded || 0) / p.total) * 40);
            const mbLoaded = (p.loaded / (1024 * 1024)).toFixed(1);
            const mbTotal = (p.total / (1024 * 1024)).toFixed(1);
            onProgress?.(pct, `Loading AI Model: ${p.file || "weights"} (${mbLoaded}/${mbTotal} MB)`);
          } else if (p.status === "ready") {
            onProgress?.(70, "AI Model ready! Transcribing speech...");
          }
        },
      });
      currentWhisperModel = targetModel;
      console.log(`[SubStudio] [Pipeline Success] Whisper pipeline (${targetModel}) loaded!`);
      return whisperPipeline;
    } catch (err: any) {
      console.error("[SubStudio] [Pipeline Fatal] Whisper pipeline loader failed:", err);
      throw new Error(`AI Model download failed: ${err?.message || "Network / CORS error"}`);
    }
  }

  // ─── Fast In-Memory WebCodecs MP4/MOV Audio Demuxer & Decoder ─
  async function decodeAudioWithWebCodecs(file: File): Promise<{ audioData: Float32Array; duration: number } | null> {
    if (typeof (window as any).AudioDecoder === "undefined") return null;

    return new Promise(async (resolve) => {
      try {
        if (!(window as any).MP4Box) {
          await new Promise<void>((res, rej) => {
            const script = document.createElement("script");
            script.src = "https://cdn.jsdelivr.net/npm/mp4box@0.5.2/dist/mp4box.all.min.js";
            script.onload = () => res();
            script.onerror = (e) => rej(e);
            document.head.appendChild(script);
          });
        }

        const MP4Box = (window as any).MP4Box;
        if (!MP4Box) return resolve(null);

        const mp4boxfile = MP4Box.createFile();
        const arrayBuffer = await file.arrayBuffer();
        (arrayBuffer as any).fileStart = 0;

        let audioTrack: any = null;
        let decoder: any = null;
        const pcmChunks: Float32Array[] = [];
        let totalPcmSamples = 0;
        let trackSampleRate = 44100;
        let trackTimescale = 1000;
        let trackDuration = 0;
        let isConfigured = false;

        const configureDecoder = (track: any) => {
          if (isConfigured) return;
          isConfigured = true;

          trackSampleRate = track.audio?.sample_rate || 44100;
          trackTimescale = track.timescale || trackSampleRate;
          trackDuration = (track.duration || 0) / trackTimescale;

          const sampleRateMap: Record<number, number> = {
            96000: 0, 88200: 1, 64000: 2, 48000: 3, 44100: 4, 32000: 5,
            24000: 6, 22050: 7, 16000: 8, 12000: 9, 11025: 10, 8000: 11, 7350: 12,
          };
          const freqIdx = sampleRateMap[trackSampleRate] !== undefined ? sampleRateMap[trackSampleRate] : 4;
          const aot = 2; // AAC-LC
          const ch = track.audio?.channel_count || 2;
          const byte1 = (aot << 3) | (freqIdx >> 1);
          const byte2 = ((freqIdx & 1) << 7) | (ch << 3);
          const aacDesc = new Uint8Array([byte1, byte2]);

          const codecStr = track.codec && track.codec.startsWith("mp4a") ? track.codec : "mp4a.40.2";

          decoder = new (window as any).AudioDecoder({
            output: (audioData: any) => {
              const numFrames = audioData.numberOfFrames;
              const channelData = new Float32Array(numFrames);
              audioData.copyTo(channelData, { planeIndex: 0, format: "f32-planar" });
              pcmChunks.push(channelData);
              totalPcmSamples += numFrames;
              if (audioData.sampleRate) trackSampleRate = audioData.sampleRate;
              audioData.close();
            },
            error: (e: any) => {
              console.warn("[SubStudio] AudioDecoder error:", e);
            },
          });

          decoder.configure({
            codec: codecStr,
            sampleRate: trackSampleRate,
            numberOfChannels: ch,
            description: aacDesc,
          });
        };

        mp4boxfile.onReady = function (info: any) {
          if (!info.audioTracks || info.audioTracks.length === 0) {
            resolve(null);
            return;
          }

          audioTrack = info.audioTracks[0];
          configureDecoder(audioTrack);

          if (info.duration && info.timescale) {
            trackDuration = Math.max(trackDuration, info.duration / info.timescale);
          }

          mp4boxfile.setExtractionOptions(audioTrack.id, null, { nbSamples: 100000 });
          mp4boxfile.start();
        };

        mp4boxfile.onSamples = function (_id: number, _user: any, samples: any[]) {
          if (!decoder && audioTrack) configureDecoder(audioTrack);
          if (decoder && samples && samples.length > 0) {
            for (const sample of samples) {
              const chunk = new (window as any).EncodedAudioChunk({
                type: sample.is_sync ? "key" : "delta",
                timestamp: (1e6 * sample.cts) / (sample.timescale || trackTimescale),
                duration: (1e6 * sample.duration) / (sample.timescale || trackTimescale),
                data: sample.data,
              });
              decoder.decode(chunk);
            }
          }
        };

        mp4boxfile.onError = function (e: any) {
          console.warn("[SubStudio] MP4Box error:", e);
        };

        mp4boxfile.appendBuffer(arrayBuffer);
        mp4boxfile.flush();

        if (decoder) {
          await decoder.flush().catch(() => {});
          decoder.close();
        }

        if (pcmChunks.length === 0 || totalPcmSamples === 0) {
          resolve(null);
          return;
        }

        const fullPcm = new Float32Array(totalPcmSamples);
        let offset = 0;
        for (const c of pcmChunks) {
          fullPcm.set(c, offset);
          offset += c.length;
        }

        const calculatedDur = totalPcmSamples / trackSampleRate;
        const finalDur = Math.max(trackDuration, calculatedDur);

        // High-quality polyphase sinc anti-aliasing resampling using OfflineAudioContext
        try {
          const tempBuffer = new AudioBuffer({
            numberOfChannels: 1,
            length: fullPcm.length,
            sampleRate: trackSampleRate,
          });
          tempBuffer.copyToChannel(fullPcm, 0);

          const targetLen = Math.ceil(finalDur * 16000);
          const offlineCtx = new OfflineAudioContext(1, targetLen, 16000);
          const source = offlineCtx.createBufferSource();
          source.buffer = tempBuffer;
          source.connect(offlineCtx.destination);
          source.start(0);

          const resampledBuffer = await offlineCtx.startRendering();
          resolve({ audioData: resampledBuffer.getChannelData(0), duration: finalDur });
        } catch (_) {
          resolve({ audioData: fullPcm, duration: finalDur });
        }
      } catch (e) {
        console.warn("[SubStudio] decodeAudioWithWebCodecs exception:", e);
        resolve(null);
      }
    });
  }

  async function extractAudioData(file: File): Promise<{ audioData: Float32Array; duration: number } | null> {
    // 1. Primary: Native AudioContext.decodeAudioData (instant, studio quality for MP4, MOV, WebM, MP3, WAV, AAC)
    try {
      console.log("[SubStudio] extractAudioData: starting WebAudio decodeAudioData, file size:", file.size, "type:", file.type);
      const arrayBuffer = await file.arrayBuffer();
      const tempAudioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      
      if (tempAudioCtx.state === "suspended") {
        await tempAudioCtx.resume().catch(() => {});
      }

      let decodedBuffer: AudioBuffer | null = null;
      try {
        decodedBuffer = await tempAudioCtx.decodeAudioData(arrayBuffer.slice(0));
      } catch (e) {
        console.warn("[SubStudio] extractAudioData: primary decodeAudioData rejected, will try WebCodecs fallback:", e);
      } finally {
        try { await tempAudioCtx.close(); } catch (_) {}
      }

      if (decodedBuffer && decodedBuffer.length > 0) {
        // Resample with anti-aliasing to 16,000 Hz Mono Float32Array (Whisper native format)
        const targetSampleRate = 16000;
        const targetLength = Math.ceil(decodedBuffer.duration * targetSampleRate);
        const offlineCtx = new OfflineAudioContext(1, targetLength, targetSampleRate);
        const source = offlineCtx.createBufferSource();
        source.buffer = decodedBuffer;
        source.connect(offlineCtx.destination);
        source.start(0);

        const resampledBuffer = await offlineCtx.startRendering();
        const audioData = resampledBuffer.getChannelData(0);
        console.log("[SubStudio] extractAudioData: WebAudio SUCCESS, samples:", audioData.length, "duration:", decodedBuffer.duration);
        sendCloudflareLog("info", "WebAudio extraction success", {
          samples: audioData.length,
          durationSec: decodedBuffer.duration,
          fileSize: file.size,
        });

        return { audioData, duration: decodedBuffer.duration };
      }
    } catch (err) {
      console.warn("[SubStudio] extractAudioData WebAudio exception:", err);
    }

    // 2. Secondary: WebCodecs + MP4Box for MP4/MOV if decodeAudioData did not support the container
    try {
      console.log("[SubStudio] Attempting WebCodecs + MP4Box audio extraction...");
      const wcResult = await decodeAudioWithWebCodecs(file);
      if (wcResult && wcResult.audioData && wcResult.audioData.length > 0) {
        console.log("[SubStudio] WebCodecs extraction SUCCESS, samples:", wcResult.audioData.length, "duration:", wcResult.duration);
        sendCloudflareLog("info", "WebCodecs audio extraction success", {
          samples: wcResult.audioData.length,
          durationSec: wcResult.duration,
          fileSize: file.size,
        });
        return wcResult;
      }
    } catch (e) {
      console.warn("[SubStudio] WebCodecs extraction fallback failed:", e);
    }

    return null;
  }

  // ─── Fallback: Extract Audio via Video Element Fast-Capture ─
  async function extractAudioViaCapture(blobUrl: string, mediaDuration: number): Promise<Float32Array | null> {
    return new Promise(async (resolve) => {
      try {
        console.log("[SubStudio] extractAudioViaCapture: starting, duration:", mediaDuration);
        const tempVideo = document.createElement("video");
        tempVideo.crossOrigin = "anonymous";
        tempVideo.preload = "auto";
        tempVideo.playsInline = true;
        tempVideo.muted = false;
        tempVideo.volume = 1.0;
        tempVideo.style.position = "fixed";
        tempVideo.style.left = "-9999px";
        tempVideo.style.width = "1px";
        tempVideo.style.height = "1px";
        tempVideo.style.opacity = "0";
        tempVideo.style.pointerEvents = "none";
        document.body.appendChild(tempVideo);

        const captureCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        if (captureCtx.state === "suspended") {
          await captureCtx.resume().catch(() => {});
        }

        tempVideo.src = blobUrl;

        let sourceNode: MediaElementAudioSourceNode;
        try {
          sourceNode = captureCtx.createMediaElementSource(tempVideo);
        } catch (e) {
          console.warn("[SubStudio] extractAudioViaCapture: createMediaElementSource FAILED:", e);
          try { captureCtx.close(); } catch (_) {}
          try { tempVideo.remove(); } catch (_) {}
          resolve(null);
          return;
        }

        const silentGain = captureCtx.createGain();
        silentGain.gain.value = 0;
        sourceNode.connect(silentGain);
        silentGain.connect(captureCtx.destination);

        const processor = captureCtx.createScriptProcessor(4096, 1, 1);
        const chunks: Float32Array[] = [];
        let totalSamples = 0;
        const maxDurationSec = mediaDuration > 0 && mediaDuration !== 10 ? mediaDuration : 600;
        const nativeSampleRate = captureCtx.sampleRate || 44100;
        const maxSamples = Math.ceil(maxDurationSec * nativeSampleRate);

        processor.onaudioprocess = (e) => {
          if (totalSamples >= maxSamples) return;
          const data = e.inputBuffer.getChannelData(0);
          const copy = new Float32Array(data);
          chunks.push(copy);
          totalSamples += copy.length;
        };

        sourceNode.connect(processor);
        processor.connect(captureCtx.destination);

        const cleanup = () => {
          try { processor.disconnect(); } catch (_) {}
          try { sourceNode.disconnect(); } catch (_) {}
          try { silentGain.disconnect(); } catch (_) {}
          try { captureCtx.close(); } catch (_) {}
          try { tempVideo.pause(); tempVideo.src = ""; tempVideo.remove(); } catch (_) {}
        };

        let captureFinished = false;
        const finishCapture = () => {
          if (captureFinished) return;
          captureFinished = true;
          cleanup();
          if (chunks.length === 0 || totalSamples === 0) {
            resolve(null);
            return;
          }
          const total = Math.min(totalSamples, maxSamples);
          const rawResult = new Float32Array(total);
          let offset = 0;
          for (const chunk of chunks) {
            const remaining = total - offset;
            if (remaining <= 0) break;
            const copyLen = Math.min(chunk.length, remaining);
            rawResult.set(chunk.subarray(0, copyLen), offset);
            offset += copyLen;
          }

          if (nativeSampleRate === 16000) {
            resolve(rawResult);
          } else {
            const ratio = nativeSampleRate / 16000;
            const outLength = Math.floor(rawResult.length / ratio);
            const resampled = new Float32Array(outLength);
            for (let i = 0; i < outLength; i++) {
              const srcIdx = Math.floor(i * ratio);
              resampled[i] = rawResult[srcIdx] || 0;
            }
            resolve(resampled);
          }
        };

        tempVideo.onended = finishCapture;
        tempVideo.onerror = (e) => {
          console.warn("[SubStudio] extractAudioViaCapture: video error:", e);
          cleanup();
          resolve(null);
        };

        const timeoutMs = Math.max(15000, (maxDurationSec * 1000) / 2 + 5000);
        setTimeout(() => {
          if (totalSamples > 0) finishCapture();
          else { cleanup(); resolve(null); }
        }, timeoutMs);

        tempVideo.oncanplay = () => {
          try { tempVideo.playbackRate = 4.0; } catch (_) {}
          tempVideo.play().catch((e) => {
            console.warn("[SubStudio] extractAudioViaCapture: play() FAILED:", e);
            cleanup();
            resolve(null);
          });
        };
      } catch (e) {
        console.warn("[SubStudio] extractAudioViaCapture: EXCEPTION:", e);
        resolve(null);
      }
    });
  }

  // ─── Whisper Hallucination Filter ───────────────────────────
  function isHallucination(text: string): boolean {
    const t = text.trim();
    if (!t || t.length < 2) return true;

    const hallucinationPatterns = [
      /^[\s.,!?…:;*~^#&/\\-]+$/,
      /(.{3,})\1{2,}/i,
      /^(thanks?|thank you)\s*(for watching|for listening)?\.?$/i,
      /^(subscribe|like and subscribe|please subscribe)/i,
      /^(music|applause|laughter|laughing|cheering|silence|cough|sighs?)\.?$/i,
      /^\[.+\]$/i, // e.g. [MUSIC], [LAUGHTER], [BLANK_AUDIO], [APPLAUSE], [NOISE]
      /^\(.+\)$/i, // e.g. (LAUGHTER), (LAUGHING), (APPLAUSE), (GIGGLES), (CHEERING), (SIGHS), (BELL DING)
      /^you$/i,
      /^\s*\.{2,}\s*$/,
      /^(um|uh|hmm|ah|er|eh)\s*$/i,
    ];

    for (const pat of hallucinationPatterns) {
      if (pat.test(t)) return true;
    }

    // Filter repeated sound token loops e.g. "(LAUGHTER) (LAUGHTER)"
    const cleanTokens = t.replace(/[()[\].,!?]/g, "").trim().split(/\s+/).filter(Boolean);
    if (cleanTokens.length > 0 && cleanTokens.every((tok) => {
      const lower = tok.toLowerCase();
      return lower === "laughter" || lower === "music" || lower === "applause" || lower === "cheering" || lower === "laughing";
    })) {
      return true;
    }

    if (t.replace(/[()[\]\s.,!?]/g, "").length < 2) return true;

    return false;
  }

  async function handleLoadedMedia(file: File) {
    isTranscribingCancelled = false;
    loadingOverlay?.classList.remove("hidden");
    updateProgress("Loading media into player...", 10, file.name);

    if (activeMediaBlobUrl) {
      URL.revokeObjectURL(activeMediaBlobUrl);
    }

    const fileUrl = URL.createObjectURL(file);
    activeMediaBlobUrl = fileUrl;

    const isVideo = file.type.startsWith("video/") || /\.(mp4|mov|webm|mkv|m4v|avi)$/i.test(file.name);
    const isAudio = file.type.startsWith("audio/") || /\.(mp3|wav|m4a|aac|ogg|flac)$/i.test(file.name);

    if (uploadMediaBtnText) {
      uploadMediaBtnText.textContent = file.name.length > 18 ? `${file.name.substring(0, 15)}...` : file.name;
    }

    let exactDuration = 12.5;

    if (isVideo) {
      mediaType = "video";
      isCustomMediaLoaded = true;
      userVideoEl.src = fileUrl;
      userVideoEl.classList.remove("hidden");
      canvas.classList.add("hidden");
      audioBadge?.classList.add("hidden");

      if (userAudioEl) {
        userAudioEl.pause();
        userAudioEl.src = "";
      }

      updateProgress("Detecting video format & duration...", 20, "Reading media metadata");
      exactDuration = await probeMediaDuration(userVideoEl);
      duration = exactDuration;
      updateTimeUI();

      if (userVideoEl.videoWidth && userVideoEl.videoHeight) {
        if (userVideoEl.videoWidth > userVideoEl.videoHeight) {
          setAspectRatio("16-9");
        } else if (Math.abs(userVideoEl.videoWidth - userVideoEl.videoHeight) < 40) {
          setAspectRatio("1-1");
        } else {
          setAspectRatio("9-16");
        }
      }
    } else if (isAudio) {
      mediaType = "audio";
      isCustomMediaLoaded = true;
      userAudioEl.src = fileUrl;
      userVideoEl.classList.add("hidden");
      userVideoEl.src = "";
      canvas.classList.remove("hidden");
      audioBadge?.classList.remove("hidden");
      if (audioFilenameBadge) audioFilenameBadge.textContent = file.name;

      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        const source = audioContext.createMediaElementSource(userAudioEl);
        audioAnalyser = audioContext.createAnalyser();
        audioAnalyser.fftSize = 64;
        source.connect(audioAnalyser);
        audioAnalyser.connect(audioContext.destination);
        audioDataArray = new Uint8Array(audioAnalyser.frequencyBinCount);
      } catch (_) {}

      updateProgress("Detecting audio track length...", 20, "Reading audio headers");
      exactDuration = await probeMediaDuration(userAudioEl);
      duration = exactDuration;
      updateTimeUI();
    }

    if (isTranscribingCancelled) return;

    // 1. Extract audio track from media
    updateProgress("Extracting speech audio from media...", 30, "Decoding waveform for AI");
    let audioResult: { audioData: Float32Array; duration: number } | null = null;
    try {
      audioResult = await extractAudioData(file);
      console.log("[SubStudio] Primary extraction result:", audioResult ? `OK (${audioResult.audioData.length} samples)` : "FAILED");
    } catch (err) {
      console.warn("[SubStudio] Primary audio extraction error:", err);
      sendCloudflareLog("warn", "Primary audio extraction exception", { error: String(err) });
    }

    // 1b. Fallback: capture audio from the video element if decodeAudioData failed
    if (!audioResult && isVideo && activeMediaBlobUrl && !isTranscribingCancelled) {
      updateProgress("Extracting video audio stream...", 35, "Capturing speech from media playback");
      try {
        const capturedAudio = await extractAudioViaCapture(activeMediaBlobUrl, duration);
        console.log("[SubStudio] Fallback capture result:", capturedAudio ? `OK (${capturedAudio.length} samples)` : "FAILED");
        if (capturedAudio && capturedAudio.length > 800) {
          audioResult = { audioData: capturedAudio, duration: duration };
        }
      } catch (err) {
        console.warn("[SubStudio] Fallback audio capture error:", err);
        sendCloudflareLog("warn", "Fallback audio capture exception", { error: String(err) });
      }
    }

    if (audioResult && audioResult.duration > 0) {
      duration = Math.max(duration, audioResult.duration);
      updateTimeUI();
    }

    let generatedCues: SubtitleCue[] = [];
    let transcriptionError: Error | null = null;

    // 2. Perform High-Accuracy AI Speech Recognition (Cloudflare Workers AI -> Client Whisper Fallback)
    if (audioResult && audioResult.audioData && audioResult.audioData.length > 0 && !isTranscribingCancelled) {
      const selectedLangRaw = speechLangSelect?.value || "auto";
      const totalDurationSec = audioResult.duration || (audioResult.audioData.length / 16000);
      console.log(`[SubStudio] Step 2: Running High-Accuracy AI transcription on ${audioResult.audioData.length} samples (~${totalDurationSec.toFixed(1)}s audio), selected language: ${selectedLangRaw}...`);
      
      sendCloudflareLog("info", "Starting AI transcription pipeline", {
        totalSamples: audioResult.audioData.length,
        totalDurationSec: totalDurationSec.toFixed(1),
        selectedLang: selectedLangRaw,
      });

      // ─── Pipeline 2A: Cloudflare Workers AI Whisper (Serverless GPU, 25s Parallel Chunking) ────
      let serverAiSuccess = false;
      try {
        updateProgress("Transcribing speech with Cloudflare AI Whisper...", 45, "Running GPU-accelerated Whisper with Voice Activity Detection");
        console.log("[SubStudio] [Pipeline 2A] Preparing high-accuracy 25s audio chunks for Cloudflare AI...");

        const sampleRate = 16000;
        const chunkDuration = 25; // 25s chunk prevents Whisper repetition loops & hallucination
        const chunkSamples = chunkDuration * sampleRate;
        const totalSamples = audioResult.audioData.length;
        const totalChunks = Math.max(1, Math.ceil(totalSamples / chunkSamples));

        const chunkPromises = [];
        for (let c = 0; c < totalChunks; c++) {
          const startIdx = c * chunkSamples;
          const endIdx = Math.min(totalSamples, (c + 1) * chunkSamples);
          const chunkAudio = audioResult.audioData.slice(startIdx, endIdx);
          const timeOffset = c * chunkDuration;
          const chunkWav = encodeAudioToWav(chunkAudio, sampleRate);

          chunkPromises.push(
            fetch("/api/transcribe", {
              method: "POST",
              headers: {
                "Content-Type": "audio/wav",
                "X-Language": selectedLangRaw,
              },
              body: chunkWav,
            })
            .then(async (resp) => {
              if (!resp.ok) return [];
              const data = await resp.json();
              if (data.ok && Array.isArray(data.cues)) {
                return data.cues.map((cue: SubtitleCue) => ({
                  ...cue,
                  start: Number((cue.start + timeOffset).toFixed(2)),
                  end: Number((cue.end + timeOffset).toFixed(2)),
                }));
              }
              return [];
            })
            .catch((err) => {
              console.warn(`[SubStudio] Chunk ${c + 1} server request error:`, err);
              return [];
            })
          );
        }

        const chunkResults = await Promise.all(chunkPromises);
        let mergedCues: SubtitleCue[] = [];
        let cueId = 1;
        let lastEnd = 0;

        for (const chunkCues of chunkResults) {
          for (const cue of chunkCues) {
            const cleanText = cue.text.trim();
            if (!cleanText || isHallucination(cleanText)) continue;

            // Deduplicate consecutive identical text
            if (mergedCues.length > 0) {
              const prev = mergedCues[mergedCues.length - 1];
              if (prev.text === cleanText && Math.abs(cue.start - prev.start) < 3.0) {
                prev.end = Math.max(prev.end, cue.end);
                lastEnd = prev.end;
                continue;
              }
            }

            let start = Math.max(lastEnd, cue.start);
            let end = Math.max(start + 0.6, cue.end);

            mergedCues.push({
              id: String(cueId++),
              start: Number(start.toFixed(2)),
              end: Number(end.toFixed(2)),
              text: cleanText,
            });
            lastEnd = end;
          }
        }

        if (mergedCues.length > 0) {
          generatedCues = mergedCues;
          serverAiSuccess = true;
          console.log(`[SubStudio] [Pipeline 2A Success] Received ${generatedCues.length} high-accuracy subtitle cues from Cloudflare AI Whisper!`);
          sendCloudflareLog("info", "Server AI transcription success", {
            cuesCount: generatedCues.length,
            chunks: totalChunks,
          });
        }
      } catch (serverErr: any) {
        console.warn("[SubStudio] [Pipeline 2A Warning] Server transcription error, proceeding to client fallback:", serverErr);
      }

      // ─── Pipeline 2B: Client-Side WebAssembly Whisper (Offline/Local Fallback) ───
      if (!serverAiSuccess && !isTranscribingCancelled) {
        try {
          console.log("[SubStudio] [Pipeline 2B] Running on-device client-side Whisper fallback...");
          updateProgress("Loading on-device AI transcription engine...", 55, "Client-side Whisper AI fallback");

          const transcriber = await getWhisperPipeline(selectedLangRaw, (pct, text) => {
            if (!isTranscribingCancelled) {
              updateProgress(text, pct, "Running on-device AI model");
            }
          });

          if (!isTranscribingCancelled && transcriber) {
            updateProgress("Transcribing spoken speech with on-device AI...", 70, "Detecting spoken words & precise timestamps");

            // Process audio in 20-second safe chunks to ensure zero WebAssembly buffer overflows
            const sampleRate = 16000;
            const chunkDuration = 20; // 20s per chunk
            const chunkSamples = chunkDuration * sampleRate;
            const totalSamples = audioResult.audioData.length;
            const totalChunks = Math.max(1, Math.ceil(totalSamples / chunkSamples));
            let cueIndex = 1;
            let lastEnd = 0;

            const addCue = (start: number, end: number, text: string) => {
              const cleanText = text.trim().toUpperCase();
              if (!cleanText || isHallucination(cleanText)) return;

              let cueStart = Number(Math.max(lastEnd, start).toFixed(1));
              let cueEnd = Number(Math.max(cueStart + 0.6, end).toFixed(1));

              if (generatedCues.length > 0) {
                const prevCue = generatedCues[generatedCues.length - 1];
                if (prevCue.text === cleanText && Math.abs(cueStart - prevCue.start) < 2.5) {
                  prevCue.end = Math.max(prevCue.end, cueEnd);
                  lastEnd = prevCue.end;
                  return;
                }
                if (cueStart < prevCue.end) {
                  cueStart = Number((prevCue.end + 0.05).toFixed(1));
                  cueEnd = Number(Math.max(cueStart + 0.6, cueEnd).toFixed(1));
                }
              }

              generatedCues.push({
                id: String(cueIndex++),
                start: cueStart,
                end: cueEnd,
                text: cleanText,
              });
              lastEnd = cueEnd;
            };

            for (let c = 0; c < totalChunks; c++) {
              if (isTranscribingCancelled) break;
              const startIdx = c * chunkSamples;
              const endIdx = Math.min(totalSamples, (c + 1) * chunkSamples);
              const chunkData = audioResult.audioData.slice(startIdx, endIdx);
              const timeOffset = c * chunkDuration;

              const pct = Math.round(70 + ((c + 1) / totalChunks) * 25);
              updateProgress(`Transcribing speech part ${c + 1} of ${totalChunks}...`, pct, `Processed ${formatTime(timeOffset)}`);

              try {
                const transcribeOptions: any = {
                  return_timestamps: true,
                  task: "transcribe",
                };
                if (selectedLangRaw && selectedLangRaw !== "auto" && !selectedLangRaw.startsWith("en")) {
                  const langCode = selectedLangRaw.split("-")[0];
                  transcribeOptions.language = langCode;
                }

                const result = await transcriber(chunkData, transcribeOptions);
                console.log(`[SubStudio] [Pipeline 2B] Chunk ${c + 1}/${totalChunks} result:`, result);

                if (result && result.chunks && result.chunks.length > 0) {
                  for (const segment of result.chunks) {
                    const rawText = (segment.text || "").trim();
                    if (!rawText || isHallucination(rawText)) continue;

                    let segStart = (segment.timestamp?.[0] || 0) + timeOffset;
                    let segEnd = (segment.timestamp?.[1] || 2.0) + timeOffset;
                    if (segEnd <= segStart) segEnd = segStart + 2.0;

                    const words = rawText.split(/\s+/).filter(Boolean);
                    if (words.length <= 4) {
                      addCue(segStart, segEnd, rawText);
                    } else {
                      const wordChunkSize = 3;
                      const totalSubChunks = Math.ceil(words.length / wordChunkSize);
                      const totalSpan = Math.max(0.6 * totalSubChunks, segEnd - segStart);
                      const subSpan = totalSpan / totalSubChunks;

                      for (let sc = 0; sc < totalSubChunks; sc++) {
                        const subWords = words.slice(sc * wordChunkSize, (sc + 1) * wordChunkSize);
                        const cStart = Number((segStart + sc * subSpan).toFixed(1));
                        const cEnd = Number((segStart + (sc + 1) * subSpan - 0.05).toFixed(1));
                        addCue(cStart, cEnd, subWords.join(" "));
                      }
                    }
                  }
                } else if (result && result.text && result.text.trim()) {
                  const rawText = result.text.trim();
                  if (!isHallucination(rawText)) {
                    const words = rawText.split(/\s+/).filter(Boolean);
                    const wordChunkSize = 3;
                    const totalSubChunks = Math.max(1, Math.ceil(words.length / wordChunkSize));
                    const chunkSpan = (endIdx - startIdx) / sampleRate;
                    const subSpan = chunkSpan / totalSubChunks;

                    for (let sc = 0; sc < totalSubChunks; sc++) {
                      const subWords = words.slice(sc * wordChunkSize, (sc + 1) * wordChunkSize);
                      const cStart = Number((timeOffset + sc * subSpan).toFixed(1));
                      const cEnd = Number(((timeOffset + (sc + 1) * subSpan) - 0.05).toFixed(1));
                      addCue(cStart, cEnd, subWords.join(" "));
                    }
                  }
                }
              } catch (chunkErr) {
                console.warn(`[SubStudio] Chunk ${c + 1} transcription notice:`, chunkErr);
              }
            }

            console.log(`[SubStudio] [Pipeline 2B Complete] Generated ${generatedCues.length} cues.`);
          }
        } catch (aiErr: any) {
          transcriptionError = aiErr;
          console.error("[SubStudio] AI Client Whisper Error:", aiErr);
          sendCloudflareLog("error", "Client Whisper error", {
            error: aiErr?.message || String(aiErr),
          });
        }
      }
    } else {
      console.warn("[SubStudio] Skipped AI transcription: No audio waveform extracted or operation was cancelled.");
      sendCloudflareLog("warn", "Skipped AI transcription: No audio extracted or cancelled");
    }

    if (isTranscribingCancelled) return;

    // 3. Status notification if audio is silent or no spoken words detected
    if (generatedCues.length === 0) {
      if (transcriptionError) {
        console.warn(`[SubStudio] Transcription error: ${transcriptionError.message || transcriptionError}`);
        updateProgress("Opening Studio Editor...", 95, "No subtitles generated (AI issue). Add lines manually anytime.");
      } else {
        console.log("[SubStudio] No spoken speech detected in audio track.");
        updateProgress("Opening Studio Editor...", 95, "No speech detected in audio. Add lines manually or use Live Mic.");
      }
    } else {
      updateProgress("Complete!", 100, `Generated ${generatedCues.length} high-accuracy subtitle cues!`);
    }
    currentCues = generatedCues;
    renderCuesTable();

    setTimeout(() => {
      loadingOverlay?.classList.add("hidden");
      switchTab("editor");
      seekTo(0);

      // Auto-play the video so it's not frozen
      if (mediaType === "video" && userVideoEl && userVideoEl.src) {
        userVideoEl.currentTime = 0;
        userVideoEl.play().then(() => setPlayingState(true)).catch(() => {});
      } else if (mediaType === "audio" && userAudioEl && userAudioEl.src) {
        userAudioEl.currentTime = 0;
        userAudioEl.play().then(() => setPlayingState(true)).catch(() => {});
      }
    }, 350);
  }

  // ─── Live Microphone Speech Recognition ─────────────────────
  const liveSpeechBtn = document.getElementById("live-speech-btn");
  const micLabel = document.getElementById("mic-label");
  const micPulse = document.getElementById("mic-pulse");
  const speechLangSelect = document.getElementById("speech-lang-select") as HTMLSelectElement;
  const liveSpeechPreviewBox = document.getElementById("live-speech-preview-box");
  const liveSpeechPreviewText = document.getElementById("live-speech-preview-text");
  const speechTimer = document.getElementById("speech-timer");

  let recognition: any = null;
  let isRecordingVoice = false;
  let finalizedCues: SubtitleCue[] = [];
  let recordStartTime = 0;
  let timerInterval: any = null;
  let lastFinalTime = 0;

  const SpeechRecognitionAPI =
    (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

  function initRecognition() {
    if (!SpeechRecognitionAPI) return null;
    const rec = new SpeechRecognitionAPI();
    rec.continuous = true;
    rec.interimResults = true;
    rec.lang = speechLangSelect?.value || "en-US";

    rec.onstart = () => {
      isRecordingVoice = true;
      finalizedCues = [];
      lastFinalTime = 0;
      recordStartTime = performance.now();
      if (micLabel) micLabel.textContent = "Stop Recording (Click to Finish)";
      micPulse?.classList.remove("hidden");
      liveSpeechPreviewBox?.classList.remove("hidden");
      if (liveSpeechPreviewText)
        liveSpeechPreviewText.textContent = "Listening... Speak clearly into your mic.";

      timerInterval = setInterval(() => {
        const elapsed = Math.floor((performance.now() - recordStartTime) / 1000);
        if (speechTimer) speechTimer.textContent = formatTime(elapsed);
      }, 500);
    };

    rec.onresult = (event: any) => {
      let interimStr = "";

      for (let i = event.resultIndex; i < event.results.length; ++i) {
        const res = event.results[i];
        const text = res[0].transcript.trim();

        if (res.isFinal) {
          if (text) {
            const nowSec = (performance.now() - recordStartTime) / 1000;
            const start = Number(lastFinalTime.toFixed(1));
            const end = Number(Math.max(start + 1.2, nowSec).toFixed(1));
            lastFinalTime = end + 0.2;

            // Split into punchy 3-5 word subtitle lines for viral readability
            const words = text.split(/\s+/);
            if (words.length <= 4) {
              finalizedCues.push({
                id: String(Date.now() + finalizedCues.length),
                start,
                end,
                text: text.toUpperCase(),
              });
            } else {
              const chunkSize = 3;
              const totalChunks = Math.ceil(words.length / chunkSize);
              const chunkDur = (end - start) / totalChunks;
              for (let c = 0; c < totalChunks; c++) {
                const chunkWords = words.slice(c * chunkSize, (c + 1) * chunkSize);
                const cStart = Number((start + c * chunkDur).toFixed(1));
                const cEnd = Number((cStart + chunkDur - 0.05).toFixed(1));
                finalizedCues.push({
                  id: String(Date.now() + finalizedCues.length),
                  start: cStart,
                  end: Math.max(cStart + 0.5, cEnd),
                  text: chunkWords.join(" ").toUpperCase(),
                });
              }
            }
          }
        } else {
          interimStr += text + " ";
        }
      }

      if (liveSpeechPreviewText) {
        if (interimStr.trim()) {
          liveSpeechPreviewText.textContent = `🗣️ Hearing: "${interimStr.trim()}"`;
        } else if (finalizedCues.length > 0) {
          liveSpeechPreviewText.textContent = `✓ Captured ${finalizedCues.length} subtitle lines. Keep speaking or click finish...`;
        }
      }
    };

    rec.onerror = (e: any) => {
      console.warn("Speech recognition error:", e);
      if (e.error !== "no-speech") {
        stopVoiceRecording();
      }
    };

    rec.onend = () => {
      if (isRecordingVoice) {
        stopVoiceRecording();
      }
    };

    return rec;
  }

  function stopVoiceRecording() {
    isRecordingVoice = false;
    if (timerInterval) clearInterval(timerInterval);
    if (micLabel) micLabel.textContent = "Record Voice (Live AI Speech)";
    micPulse?.classList.add("hidden");
    liveSpeechPreviewBox?.classList.add("hidden");

    if (recognition) {
      try {
        recognition.stop();
      } catch (_) {}
    }

    if (finalizedCues.length > 0) {
      currentCues = finalizedCues;
      duration = Math.max(10, Math.ceil(finalizedCues[finalizedCues.length - 1].end + 1));
      renderCuesTable();
      updateTimeUI();
      switchTab("editor");
    }
  }

  speechLangSelect?.addEventListener("change", () => {
    if (recognition && isRecordingVoice) {
      stopVoiceRecording();
    }
  });

  liveSpeechBtn?.addEventListener("click", () => {
    if (!SpeechRecognitionAPI) {
      alert("Live Voice Recognition is supported in Chrome, Edge, Safari, and Brave. You can also upload any video/audio file or paste a script.");
      return;
    }

    if (!isRecordingVoice) {
      recognition = initRecognition();
      try {
        recognition.start();
      } catch (err) {
        console.error(err);
      }
    } else {
      stopVoiceRecording();
    }
  });

  // Demo Sample Buttons
  document.querySelectorAll<HTMLButtonElement>(".sample-audio-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const sampleKey = btn.dataset.sample || "hormozi";
      loadingOverlay?.classList.remove("hidden");
      updateProgress("Loading demo creator preset...", 70, sampleKey);
      setTimeout(() => {
        loadingOverlay?.classList.add("hidden");
        currentCues = [...(demoSamples[sampleKey] || demoSamples.hormozi)];
        duration = Math.max(10, Math.ceil(currentCues[currentCues.length - 1].end + 1));
        mediaType = "none";
        userVideoEl.classList.add("hidden");
        userVideoEl.src = "";
        canvas.classList.remove("hidden");
        audioBadge?.classList.add("hidden");
        renderCuesTable();
        updateTimeUI();
        switchTab("editor");
      }, 400);
    });
  });

  // Script Synchronizer Logic
  const wpmSlider = document.getElementById("wpm-slider") as HTMLInputElement;
  const wpmVal = document.getElementById("wpm-val");
  wpmSlider?.addEventListener("input", () => {
    if (wpmVal) wpmVal.textContent = `${wpmSlider.value} WPM`;
  });

  const wordsSlider = document.getElementById("words-slider") as HTMLInputElement;
  const wordsVal = document.getElementById("words-val");
  wordsSlider?.addEventListener("input", () => {
    if (wordsVal) wordsVal.textContent = `${wordsSlider.value} words`;
  });

  document.getElementById("insert-sample-script")?.addEventListener("click", () => {
    const textarea = document.getElementById("script-textarea") as HTMLTextAreaElement;
    if (textarea) {
      textarea.value = "In this video, I will show you how to generate viral subtitles in under 60 seconds. You can customize colors, add active word animations, and export ready-to-publish subtitle files instantly.";
    }
  });

  document.getElementById("generate-script-cues-btn")?.addEventListener("click", () => {
    const textarea = document.getElementById("script-textarea") as HTMLTextAreaElement;
    const text = textarea?.value.trim();
    if (!text) {
      alert("Please paste or type your script text first.");
      return;
    }

    const wpm = Number(wpmSlider?.value || 160);
    const maxWordsPerLine = Number(wordsSlider?.value || 3);
    const words = text.split(/\s+/);
    const secPerWord = 60 / wpm;

    const newCues: SubtitleCue[] = [];
    let currentLineWords: string[] = [];
    let lineStartTime = 0;

    words.forEach((word, i) => {
      currentLineWords.push(word);
      const isLast = i === words.length - 1;
      const isPunctuation = /[.!?]$/.test(word);

      if (currentLineWords.length >= maxWordsPerLine || isPunctuation || isLast) {
        const lineDuration = currentLineWords.length * secPerWord;
        const lineEndTime = lineStartTime + Math.max(1.0, lineDuration);

        newCues.push({
          id: String(i),
          start: Number(lineStartTime.toFixed(1)),
          end: Number(lineEndTime.toFixed(1)),
          text: currentLineWords.join(" ").toUpperCase(),
        });

        lineStartTime = Number((lineEndTime + 0.15).toFixed(1));
        currentLineWords = [];
      }
    });

    currentCues = newCues;
    duration = Math.max(10, Math.ceil(newCues[newCues.length - 1].end + 1));
    renderCuesTable();
    updateTimeUI();
    switchTab("editor");
  });

  // Render Cues Table
  function renderCuesTable() {
    if (!cuesContainer) return;
    cuesContainer.innerHTML = "";

    currentCues.forEach((cue, index) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center gap-2 p-2.5 text-xs hover:bg-[var(--color-canvas-soft)] transition-colors group";
      row.dataset.cueId = cue.id;
      row.innerHTML = `
        <button class="cue-jump-btn shrink-0 w-6 h-6 rounded bg-[var(--color-canvas-soft-2)] hover:bg-[var(--color-ink)] hover:text-[var(--color-on-primary)] font-mono font-bold text-[10px] flex items-center justify-center transition-colors cursor-pointer" title="Jump to timestamp">
          ${index + 1}
        </button>
        <input
          type="number"
          step="0.1"
          class="cue-start-input w-14 px-1.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-mono text-center focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.start.toFixed(1)}"
          aria-label="Start time in seconds"
        />
        <span class="text-[var(--color-mute)] text-[10px]">→</span>
        <input
          type="number"
          step="0.1"
          class="cue-end-input w-14 px-1.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-mono text-center focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.end.toFixed(1)}"
          aria-label="End time in seconds"
        />
        <input
          type="text"
          class="cue-text-input flex-1 px-2.5 py-1 rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-medium focus:ring-1 focus:ring-[var(--color-link)] focus:outline-none"
          value="${cue.text}"
          aria-label="Subtitle cue text"
        />
        <button class="cue-delete-btn text-[var(--color-mute)] hover:text-[var(--color-error)] px-2 py-1 rounded text-sm transition-colors cursor-pointer" title="Delete line">
          ✕
        </button>
      `;

      row.querySelector(".cue-jump-btn")?.addEventListener("click", () => {
        seekTo(cue.start);
      });

      row.querySelector(".cue-start-input")?.addEventListener("change", (e) => {
        cue.start = Number((e.target as HTMLInputElement).value);
      });

      row.querySelector(".cue-end-input")?.addEventListener("change", (e) => {
        cue.end = Number((e.target as HTMLInputElement).value);
      });

      row.querySelector(".cue-text-input")?.addEventListener("input", (e) => {
        cue.text = (e.target as HTMLInputElement).value;
        lastRenderedCueId = "";
        updateSubtitleOverlay();
      });

      row.querySelector(".cue-delete-btn")?.addEventListener("click", () => {
        currentCues = currentCues.filter((c) => c.id !== cue.id);
        renderCuesTable();
        lastRenderedCueId = "";
        updateSubtitleOverlay();
      });

      cuesContainer.appendChild(row);
    });

    if (cueCountBadge) cueCountBadge.textContent = `${currentCues.length} cues`;
    if (currentCues.length > 0) {
      const maxEnd = currentCues[currentCues.length - 1].end;
      if (!isCustomMediaLoaded) {
        duration = Math.max(10, Math.ceil(maxEnd + 1));
        updateTimeUI();
      }
    }
  }

  // Add Cue Button
  document.getElementById("add-cue-btn")?.addEventListener("click", () => {
    const lastEnd = currentCues.length > 0 ? currentCues[currentCues.length - 1].end : 0;
    currentCues.push({
      id: String(Date.now()),
      start: Number((lastEnd + 0.2).toFixed(1)),
      end: Number((lastEnd + 2.5).toFixed(1)),
      text: "NEW VIRAL SUBTITLE LINE 🔥",
    });
    renderCuesTable();
  });

  // ─── Export Generators ──────────────────────────────────────
  function formatSrtTimestamp(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    const ms = Math.floor((seconds % 1) * 1000);
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")},${String(ms).padStart(3, "0")}`;
  }

  function formatVttTimestamp(seconds: number): string {
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    const ms = Math.floor((seconds % 1) * 1000);
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}.${String(ms).padStart(3, "0")}`;
  }

  function downloadFile(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Download .SRT
  document.getElementById("export-srt-btn")?.addEventListener("click", () => {
    let srtText = "";
    currentCues.forEach((cue, i) => {
      srtText += `${i + 1}\n`;
      srtText += `${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}\n`;
      srtText += `${cue.text}\n\n`;
    });
    downloadFile(srtText, "subtitles.srt", "text/plain");
  });

  // Download .VTT
  document.getElementById("export-vtt-btn")?.addEventListener("click", () => {
    let vttText = "WEBVTT\n\n";
    currentCues.forEach((cue, i) => {
      vttText += `${i + 1}\n`;
      vttText += `${formatVttTimestamp(cue.start)} --> ${formatVttTimestamp(cue.end)}\n`;
      vttText += `${cue.text}\n\n`;
    });
    downloadFile(vttText, "subtitles.vtt", "text/vtt");
  });

  // Download .TXT
  document.getElementById("export-txt-btn")?.addEventListener("click", () => {
    const txtContent = currentCues.map((c) => c.text).join("\n");
    downloadFile(txtContent, "transcript.txt", "text/plain");
  });

  // Copy to Clipboard
  document.getElementById("copy-all-btn")?.addEventListener("click", async () => {
    let srtText = "";
    currentCues.forEach((cue, i) => {
      srtText += `${i + 1}\n${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}\n${cue.text}\n\n`;
    });
    try {
      await navigator.clipboard.writeText(srtText);
      const btn = document.getElementById("copy-all-btn");
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = "✓ Copied!";
        setTimeout(() => {
          btn.textContent = orig;
        }, 2000);
      }
    } catch (_) {}
  });

  // ─── Burn Subtitles to Video Export Engine ───────────────────
  const burnVideoBtn = document.getElementById("burn-video-btn");
  const burnVideoLabel = document.getElementById("burn-video-label");

  burnVideoBtn?.addEventListener("click", async () => {
    if (!canvas) return;

    const hasVideo = mediaType === "video" && userVideoEl && userVideoEl.src;
    if (burnVideoLabel) burnVideoLabel.textContent = "Preparing Video Render...";
    burnVideoBtn.setAttribute("disabled", "true");

    const recordCanvas = document.createElement("canvas");
    recordCanvas.width = hasVideo && userVideoEl.videoWidth ? userVideoEl.videoWidth : 720;
    recordCanvas.height = hasVideo && userVideoEl.videoHeight ? userVideoEl.videoHeight : 1280;
    const rctx = recordCanvas.getContext("2d");
    if (!rctx) {
      burnVideoBtn.removeAttribute("disabled");
      return;
    }

    const canvasStream = recordCanvas.captureStream(30);
    let combinedStream: MediaStream = canvasStream;

    // Combine audio track from original video/audio element if available
    try {
      let mediaStreamSrc: any = null;
      if (hasVideo && (userVideoEl as any).captureStream) {
        mediaStreamSrc = (userVideoEl as any).captureStream();
      } else if (hasVideo && (userVideoEl as any).mozCaptureStream) {
        mediaStreamSrc = (userVideoEl as any).mozCaptureStream();
      }

      if (mediaStreamSrc) {
        const audioTracks = mediaStreamSrc.getAudioTracks();
        if (audioTracks && audioTracks.length > 0) {
          combinedStream = new MediaStream([...canvasStream.getVideoTracks(), audioTracks[0]]);
        }
      }
    } catch (_) {}

    let mediaRecorder: MediaRecorder;
    try {
      mediaRecorder = new MediaRecorder(combinedStream, { mimeType: "video/webm;codecs=vp9" });
    } catch (_) {
      try {
        mediaRecorder = new MediaRecorder(combinedStream, { mimeType: "video/webm" });
      } catch (_) {
        mediaRecorder = new MediaRecorder(combinedStream);
      }
    }

    const chunks: Blob[] = [];
    mediaRecorder.ondataavailable = (e) => {
      if (e.data && e.data.size > 0) chunks.push(e.data);
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: "video/webm" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "video_with_animated_subtitles.webm";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (burnVideoLabel) burnVideoLabel.textContent = "✓ Video Downloaded!";
      setTimeout(() => {
        if (burnVideoLabel) burnVideoLabel.textContent = "Download Video with Subtitles";
        burnVideoBtn.removeAttribute("disabled");
      }, 3000);
    };

    mediaRecorder.start();

    let renderTime = 0;
    // Export the COMPLETE video duration (not capped!)
    const renderDuration = Math.max(1, duration);
    const fps = 30;
    const frameInterval = 1000 / fps;

    if (hasVideo) {
      userVideoEl.currentTime = 0;
      userVideoEl.play().catch(() => {});
    }

    const renderInterval = setInterval(() => {
      renderTime += 1 / fps;

      const pct = Math.min(99, Math.round((renderTime / renderDuration) * 100));
      if (burnVideoLabel) {
        burnVideoLabel.textContent = `Rendering ${pct}% (${formatTime(renderTime)} / ${formatTime(renderDuration)})`;
      }

      // Draw background video frame or motion canvas
      if (hasVideo && userVideoEl.videoWidth) {
        rctx.drawImage(userVideoEl, 0, 0, recordCanvas.width, recordCanvas.height);
      } else {
        rctx.drawImage(canvas, 0, 0, recordCanvas.width, recordCanvas.height);
      }

      // Draw active subtitle overlay
      const activeCue = currentCues.find((c) => renderTime >= c.start && renderTime <= c.end);
      if (activeCue) {
        rctx.save();
        const posPercent = Number(posSlider?.value || 18) / 100;
        const textY = recordCanvas.height * (1 - posPercent);
        const fontSize = Math.round((Number(fontSlider?.value || 24) / 340) * recordCanvas.width);

        rctx.font = `900 ${fontSize}px 'Outfit', Inter, sans-serif`;
        rctx.textAlign = "center";
        rctx.textBaseline = "middle";

        // Draw outline / shadow
        rctx.strokeStyle = "#000000";
        rctx.lineWidth = Math.max(4, Math.round(fontSize * 0.18));
        rctx.strokeText(activeCue.text, recordCanvas.width / 2, textY);

        // Fill active color
        rctx.fillStyle = activeColor || "#facc15";
        rctx.fillText(activeCue.text, recordCanvas.width / 2, textY);
        rctx.restore();
      }

      if (renderTime >= renderDuration) {
        clearInterval(renderInterval);
        if (hasVideo) userVideoEl.pause();
        if (mediaRecorder.state !== "inactive") {
          mediaRecorder.stop();
        }
      }
    }, frameInterval);
  });

  // Initial setup
  renderCuesTable();
  animFrameId = requestAnimationFrame(tick);
</script>
