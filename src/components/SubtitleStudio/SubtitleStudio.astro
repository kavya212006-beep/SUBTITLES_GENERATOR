  // ─── AI Speech-to-Text & Audio Extraction Engine ────────────
  let whisperPipeline: any = null;

  async function getWhisperPipeline(onProgress?: (progress: number, text: string) => void) {
    if (whisperPipeline) return whisperPipeline;
    try {
      onProgress?.(30, "Initializing Whisper AI model in browser...");
      const { pipeline, env } = await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.3.3");
      env.allowLocalModels = false;
      
      whisperPipeline = await pipeline("automatic-speech-recognition", "onnx-community/whisper-tiny", {
        device: ("gpu" in navigator ? "webgpu" : "wasm") as any,
        progress_callback: (p: any) => {
          if (p.status === "progress" && p.total) {
            const pct = Math.round(30 + ((p.loaded || 0) / p.total) * 35);
            onProgress?.(pct, `Loading AI Model: ${p.file || "weights"} (${Math.round(p.progress || 0)}%)`);
          }
        },
      });
      return whisperPipeline;
    } catch (err) {
      console.warn("Primary Whisper loader failed, attempting fallback...", err);
      try {
        const { pipeline } = await import("https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2");
        whisperPipeline = await pipeline("automatic-speech-recognition", "Xenova/whisper-tiny", {
          progress_callback: (p: any) => {
            if (p.status === "progress" && p.total) {
              const pct = Math.round(30 + ((p.loaded || 0) / p.total) * 35);
              onProgress?.(pct, `Loading AI Model: ${p.file || "weights"} (${Math.round(p.progress || 0)}%)`);
            }
          },
        });
        return whisperPipeline;
      } catch (fallbackErr) {
        console.error("Whisper pipeline initialization error:", fallbackErr);
        throw fallbackErr;
      }
    }
  }

  async function extractAudioData(file: File): Promise<{ audioData: Float32Array; duration: number } | null> {
    try {
      const arrayBuffer = await file.arrayBuffer();
      const tempAudioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      
      let decodedBuffer: AudioBuffer;
      try {
        decodedBuffer = await tempAudioCtx.decodeAudioData(arrayBuffer);
      } catch (e) {
        console.warn("Direct container audio decode failed:", e);
        return null;
      } finally {
        try { await tempAudioCtx.close(); } catch (_) {}
      }

      if (!decodedBuffer || decodedBuffer.length === 0) {
        return null;
      }

      // Resample to 16,000 Hz Mono Float32Array (standard Whisper format)
      const targetSampleRate = 16000;
      const targetLength = Math.ceil(decodedBuffer.duration * targetSampleRate);
      const offlineCtx = new OfflineAudioContext(1, targetLength, targetSampleRate);
      const source = offlineCtx.createBufferSource();
      source.buffer = decodedBuffer;
      source.connect(offlineCtx.destination);
      source.start(0);

      const resampledBuffer = await offlineCtx.startRendering();
      const audioData = resampledBuffer.getChannelData(0);

      return { audioData, duration: decodedBuffer.duration };
    } catch (err) {
      console.warn("Audio extraction error:", err);
      return null;
    }
  }

  async function handleLoadedMedia(file: File) {
    loadingOverlay?.classList.remove("hidden");
    updateProgress("Analyzing media format & audio tracks...", 10, file.name);

    const fileUrl = URL.createObjectURL(file);
    const isVideo = file.type.startsWith("video/") || /\.(mp4|mov|webm|mkv|m4v)$/i.test(file.name);
    const isAudio = file.type.startsWith("audio/") || /\.(mp3|wav|m4a|aac|ogg|flac)$/i.test(file.name);

    if (uploadMediaBtnText) {
      uploadMediaBtnText.textContent = file.name.length > 18 ? `${file.name.substring(0, 15)}...` : file.name;
    }

    if (isVideo) {
      mediaType = "video";
      isCustomMediaLoaded = true;
      userVideoEl.src = fileUrl;
      userVideoEl.classList.remove("hidden");
      canvas.classList.add("hidden");
      audioBadge?.classList.add("hidden");

      if (userAudioEl) {
        userAudioEl.pause();
        userAudioEl.src = "";
      }

      userVideoEl.onloadedmetadata = () => {
        duration = Math.max(3, Math.ceil(userVideoEl.duration));
        updateTimeUI();

        if (userVideoEl.videoWidth > userVideoEl.videoHeight) {
          setAspectRatio("16-9");
        } else if (Math.abs(userVideoEl.videoWidth - userVideoEl.videoHeight) < 20) {
          setAspectRatio("1-1");
        } else {
          setAspectRatio("9-16");
        }
      };
    } else if (isAudio) {
      mediaType = "audio";
      isCustomMediaLoaded = true;
      userAudioEl.src = fileUrl;
      userVideoEl.classList.add("hidden");
      userVideoEl.src = "";
      canvas.classList.remove("hidden");
      audioBadge?.classList.remove("hidden");
      if (audioFilenameBadge) audioFilenameBadge.textContent = file.name;

      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        const source = audioContext.createMediaElementSource(userAudioEl);
        audioAnalyser = audioContext.createAnalyser();
        audioAnalyser.fftSize = 64;
        source.connect(audioAnalyser);
        audioAnalyser.connect(audioContext.destination);
        audioDataArray = new Uint8Array(audioAnalyser.frequencyBinCount);
      } catch (_) {}

      userAudioEl.onloadedmetadata = () => {
        duration = Math.max(3, Math.ceil(userAudioEl.duration));
        updateTimeUI();
      };
    }

    // 1. Extract audio track from media
    updateProgress("Extracting speech audio from media...", 20, "Extracting 16kHz speech audio stream");
    let audioResult: { audioData: Float32Array; duration: number } | null = null;
    try {
      audioResult = await extractAudioData(file);
    } catch (err) {
      console.warn("Audio extraction error:", err);
    }

    if (audioResult && audioResult.duration > 0) {
      duration = Math.max(3, Math.ceil(audioResult.duration));
      updateTimeUI();
    }

    let generatedCues: SubtitleCue[] = [];

    // 2. Perform AI Speech Recognition (Whisper)
    if (audioResult && audioResult.audioData && audioResult.audioData.length > 0) {
      try {
        updateProgress("Loading on-device AI transcription engine...", 35, "Whisper AI (Zero Server Uploads)");
        const transcriber = await getWhisperPipeline((pct, text) => {
          updateProgress(text, pct, "Running locally on device");
        });

        updateProgress("Transcribing spoken speech with AI...", 70, "Detecting spoken words & precise timestamps");

        const selectedLangRaw = speechLangSelect?.value || "auto";
        const transcribeOptions: any = {
          return_timestamps: true,
          chunk_length_s: 30,
          stride_length_s: 5,
          task: "transcribe",
        };
        if (selectedLangRaw && selectedLangRaw !== "auto") {
          const langCode = selectedLangRaw.split("-")[0];
          transcribeOptions.language = langCode;
        }

        const result = await transcriber(audioResult.audioData, transcribeOptions);

        if (result && result.chunks && result.chunks.length > 0) {
          let cueIndex = 1;
          for (const chunk of result.chunks) {
            const rawText = (chunk.text || "").trim();
            if (!rawText) continue;

            let start = chunk.timestamp?.[0];
            let end = chunk.timestamp?.[1];

            if (start === null || start === undefined) start = 0;
            if (end === null || end === undefined) end = Math.min(duration, start + 2.5);

            start = Number(Number(start).toFixed(1));
            end = Number(Math.max(start + 0.8, Number(end)).toFixed(1));

            // Break long speech segments (> 5 words) into punchy, readable subtitle lines
            const words = rawText.split(/\s+/).filter(Boolean);
            if (words.length <= 5) {
              generatedCues.push({
                id: String(cueIndex++),
                start,
                end,
                text: rawText.toUpperCase(),
              });
            } else {
              const chunkSize = 4;
              const totalSubChunks = Math.ceil(words.length / chunkSize);
              const chunkSpan = (end - start) / totalSubChunks;
              for (let c = 0; c < totalSubChunks; c++) {
                const subWords = words.slice(c * chunkSize, (c + 1) * chunkSize);
                const cStart = Number((start + c * chunkSpan).toFixed(1));
                const cEnd = Number((cStart + chunkSpan - 0.05).toFixed(1));
                generatedCues.push({
                  id: String(cueIndex++),
                  start: cStart,
                  end: Math.max(cStart + 0.6, cEnd),
                  text: subWords.join(" ").toUpperCase(),
                });
              }
            }
          }
        } else if (result && typeof result.text === "string" && result.text.trim()) {
          const words = result.text.trim().split(/\s+/).filter(Boolean);
          const chunkSize = 4;
          const totalChunks = Math.ceil(words.length / chunkSize);
          const dur = duration || 10;
          const chunkDur = dur / totalChunks;
          for (let c = 0; c < totalChunks; c++) {
            const subWords = words.slice(c * chunkSize, (c + 1) * chunkSize);
            const cStart = Number((c * chunkDur).toFixed(1));
            const cEnd = Number(Math.min(dur, (c + 1) * chunkDur - 0.1).toFixed(1));
            generatedCues.push({
              id: String(c + 1),
              start: cStart,
              end: Math.max(cStart + 0.6, cEnd),
              text: subWords.join(" ").toUpperCase(),
            });
          }
        }
      } catch (aiErr) {
        console.error("AI Transcription error:", aiErr);
      }
    }

    // 3. Fallback only if no speech was detected in audio / muted file
    if (generatedCues.length === 0) {
      updateProgress("Finalizing subtitle cues...", 85, "Ready to edit");
      const dur = duration || 10;
      const chunkDur = Math.min(2.5, dur / 3);
      const count = Math.max(2, Math.floor(dur / chunkDur));
      for (let i = 0; i < count; i++) {
        const start = Number((i * chunkDur).toFixed(1));
        const end = Number(Math.min(dur, (i + 1) * chunkDur - 0.1).toFixed(1));
        generatedCues.push({
          id: String(i + 1),
          start,
          end: Math.max(start + 0.6, end),
          text: i === 0 ? "ADD YOUR SUBTITLES HERE" : `SUBTITLE LINE ${i + 1}`,
        });
      }
    }

    updateProgress("Complete!", 100);
    currentCues = generatedCues;
    renderCuesTable();

    setTimeout(() => {
      loadingOverlay?.classList.add("hidden");
      switchTab("editor");
      seekTo(0);
    }, 400);
  }

  // ─── Live Microphone Speech Recognition ─────────────────────
  const liveSpeechBtn = document.getElementById("live-speech-btn");
  const micLabel = document.getElementById("mic-label");
  const micPulse = document.getElementById("mic-pulse");
  const speechLangSelect = document.getElementById("speech-lang-select") as HTMLSelectElement;
  const liveSpeechPreviewBox = document.getElementById("live-speech-preview-box");
  const liveSpeechPreviewText = document.getElementById("live-speech-preview-text");
  const speechTimer = document.getElementById("speech-timer");

  let recognition: any = null;
  let isRecordingVoice = false;
  let finalizedCues: SubtitleCue[] = [];
  let recordStartTime = 0;
  let timerInterval: any = null;
  let lastFinalTime = 0;

  const SpeechRecognitionAPI =
    (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

  function initRecognition() {
    if (!SpeechRecognitionAPI) return null;
    const rec = new SpeechRecognitionAPI();
    rec.continuous = true;
    rec.interimResults = true;
    rec.lang = speechLangSelect?.value || "en-US";

    rec.onstart = () => {
      isRecordingVoice = true;
      finalizedCues = [];
      lastFinalTime = 0;
      recordStartTime = performance.now();
      if (micLabel) micLabel.textContent = "Stop Recording (Click to Finish)";
      micPulse?.classList.remove("hidden");
      liveSpeechPreviewBox?.classList.remove("hidden");
      if (liveSpeechPreviewText)
        liveSpeechPreviewText.textContent = "Listening... Speak clearly into your mic.";

      timerInterval = setInterval(() => {
        const elapsed = Math.floor((performance.now() - recordStartTime) / 1000);
        if (speechTimer) speechTimer.textContent = formatTime(elapsed);
      }, 500);
    };

    rec.onresult = (event: any) => {
      let interimStr = "";

      for (let i = event.resultIndex; i < event.results.length; ++i) {
        const res = event.results[i];
        const text = res[0].transcript.trim();

        if (res.isFinal) {
          if (text) {
            const nowSec = (performance.now() - recordStartTime) / 1000;
            const start = Number(lastFinalTime.toFixed(1));
            const end = Number(Math.max(start + 1.2, nowSec).toFixed(1));
            lastFinalTime = end + 0.2;

            // Split into punchy 3-5 word subtitle lines for viral readability
            const words = text.split(/\s+/);
            if (words.length <= 4) {
              finalizedCues.push({
                id: String(Date.now() + finalizedCues.length),
                start,
                end,
                text: text.toUpperCase(),
              });
            } else {
              const chunkSize = 3;
              const totalChunks = Math.ceil(words.length / chunkSize);
              const chunkDur = (end - start) / totalChunks;
              for (let c = 0; c < totalChunks; c++) {
                const chunkWords = words.slice(c * chunkSize, (c + 1) * chunkSize);
                const cStart = Number((start + c * chunkDur).toFixed(1));
                const cEnd = Number((cStart + chunkDur - 0.05).toFixed(1));
                finalizedCues.push({
                  id: String(Date.now() + finalizedCues.length),
                  start: cStart,
                  end: Math.max(cStart + 0.5, cEnd),
                  text: chunkWords.join(" ").toUpperCase(),
                });
              }
            }
          }
        } else {
          interimStr += text + " ";
        }
      }

      if (liveSpeechPreviewText) {
        if (interimStr.trim()) {
          liveSpeechPreviewText.textContent = `🗣️ Hearing: "${interimStr.trim()}"`;
        } else if (finalizedCues.length > 0) {
          liveSpeechPreviewText.textContent = `✓ Captured ${finalizedCues.length} subtitle lines. Keep speaking or click finish...`;
        }
      }
    };

    rec.onerror = (e: any) => {
      console.warn("Speech recognition error:", e);
      if (e.error !== "no-speech") {
        stopVoiceRecording();
      }
    };

    rec.onend = () => {
      if (isRecordingVoice) {
        stopVoiceRecording();
      }
    };

    return rec;
  }

  function stopVoiceRecording() {
    isRecordingVoice = false;
    if (timerInterval) clearInterval(timerInterval);
    if (micLabel) micLabel.textContent = "Record Voice (Live AI Speech)";
    micPulse?.classList.add("hidden");
    liveSpeechPreviewBox?.classList.add("hidden");

    if (recognition) {
      try {
        recognition.stop();
      } catch (_) {}
    }

    if (finalizedCues.length > 0) {
      currentCues = finalizedCues;
      duration = Math.max(10, Math.ceil(finalizedCues[finalizedCues.length - 1].end + 1));
      renderCuesTable();
      updateTimeUI();
      switchTab("editor");
    }
  }

  speechLangSelect?.addEventListener("change", () => {
    if (recognition && isRecordingVoice) {
      stopVoiceRecording();
    }
  });

  liveSpeechBtn?.addEventListener("click", () => {
    if (!SpeechRecognitionAPI) {
      alert("Live Voice Recognition is supported in Chrome, Edge, Safari, and Brave. You can also upload any video/audio file or paste a script.");
      return;
    }

    if (!isRecordingVoice) {
      recognition = initRecognition();
      try {
        recognition.start();
      } catch (err) {
        console.error(err);
      }
    } else {
      stopVoiceRecording();
    }
