---
import { t } from "../../i18n/utils";

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylePresets = [
  {
    id: "hormozi",
    nameKey: "styles.hormozi",
    icon: "🔥",
    desc: "Bold yellow pop, high-energy retention",
  },
  {
    id: "beast",
    nameKey: "styles.beast",
    icon: "⚡",
    desc: "Thick black stroke with cyan bounce",
  },
  {
    id: "tiktok",
    nameKey: "styles.tiktok" as any,
    icon: "🚨",
    desc: "Vibrant red alert pill badge",
  },
  {
    id: "karaoke",
    nameKey: "styles.karaoke",
    icon: "🎤",
    desc: "Smooth green progressive highlight",
  },
  {
    id: "cinematic",
    nameKey: "styles.cinematic",
    icon: "🎬",
    desc: "Frosted dark pill box for film & docs",
  },
  {
    id: "minimal",
    nameKey: "styles.minimal",
    icon: "✨",
    desc: "Clean modern typography",
  },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-8">
  <!-- ─── Studio Main Card ─────────────────────────────────── -->
  <div
    class="bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden"
  >
    <!-- Top Workflow Tabs Bar -->
    <div
      class="flex items-center border-b border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] px-4 pt-3 overflow-x-auto scrollbar-hide"
      role="tablist"
    >
      <button
        id="tab-btn-audio"
        role="tab"
        aria-selected="true"
        aria-controls="panel-audio"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 border-[var(--color-ink)] text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px cursor-pointer"
      >
        <span>🎙️</span>
        <span>{t(lang, "studio.tab.audio")}</span>
      </button>
      <button
        id="tab-btn-script"
        role="tab"
        aria-selected="false"
        aria-controls="panel-script"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px cursor-pointer"
      >
        <span>📝</span>
        <span>{t(lang, "studio.tab.script")}</span>
      </button>
      <button
        id="tab-btn-editor"
        role="tab"
        aria-selected="false"
        aria-controls="panel-editor"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px cursor-pointer"
      >
        <span>🎬</span>
        <span>{t(lang, "studio.tab.editor")}</span>
        <span
          class="ms-1 px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-md bg-[var(--color-link-bg-soft)] text-[var(--color-link)]"
          >Live</span
        >
      </button>
    </div>

    <!-- ─── TAB 1: Audio / Video Transcriber ─────────────────── -->
    <div
      id="panel-audio"
      role="tabpanel"
      class="p-6 md:p-8 flex flex-col gap-6"
    >
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">
          {t(lang, "studio.tab.audio")}
        </h3>
        <p class="text-sm text-[var(--color-body)]">
          {t(lang, "audio.drop.formats")} (MP4, MOV, WebM, MP3, WAV, M4A, AAC)
        </p>
      </div>

      <!-- Drag & Drop Upload Zone -->
      <label
        id="audio-dropzone"
        for="media-file-input"
        class="flex flex-col items-center justify-center gap-4 w-full min-h-[230px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)]/40 rounded-2xl cursor-pointer transition-all group relative bg-[var(--color-canvas-soft)] text-center"
      >
        <div
          class="w-16 h-16 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform"
        >
          🎬
        </div>
        <div class="text-center max-w-md">
          <p class="text-base font-semibold text-[var(--color-ink)]">
            {t(lang, "audio.drop.title")}
          </p>
          <p class="text-xs text-[var(--color-mute)] mt-1.5 leading-relaxed">
            Drag & drop any video or audio file. We'll automatically load your media, extract the speech cadence, and generate animated subtitles.
          </p>
        </div>

        <input
          id="media-file-input"
          type="file"
          accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a,.aac,.ogg"
          class="sr-only"
        />

        <!-- Loading Progress Overlay -->
        <div
          id="transcribe-loading"
          class="hidden absolute inset-0 bg-[var(--color-canvas)]/95 backdrop-blur-md rounded-2xl flex flex-col items-center justify-center p-6 gap-4 z-20"
        >
          <div class="flex items-center gap-1.5 h-8">
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-1"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-2"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-3"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-4"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-5"></div>
          </div>
          <div class="flex flex-col items-center gap-2 max-w-sm w-full text-center">
            <p
              id="transcribe-status-text"
              class="text-sm font-semibold text-[var(--color-ink)]"
            >
              {t(lang, "audio.analyzing")}
            </p>
            <div
              class="w-full h-2.5 rounded-full bg-[var(--color-canvas-soft-2)] overflow-hidden border border-[var(--color-hairline)]"
            >
              <div
                id="transcribe-progress-bar"
                class="h-full bg-gradient-to-r from-[var(--color-link)] to-[var(--color-violet)] transition-all duration-300 w-0"
              >
              </div>
            </div>
            <span
              id="transcribe-detail-text"
              class="text-[11px] text-[var(--color-mute)]"
              >Processing media file directly in your browser</span
            >
            <button
              id="cancel-transcribe-btn"
              type="button"
              class="mt-2 px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-hairline)] text-[var(--color-ink)] bg-[var(--color-canvas)] hover:bg-[var(--color-canvas-soft-2)] hover:border-[var(--color-hairline-strong)] transition-all cursor-pointer shadow-sm"
            >
              Skip to Editor ➔
            </button>
          </div>
        </div>
      </label>

      <!-- Live Voice AI Recording & Demo Samples -->
      <div
        class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2"
      >
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
            >{t(lang, "audio.sample.heading")}</span
          >
          <button
            class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all cursor-pointer"
            data-sample="hormozi"
          >
            🔥 Hormozi Hook
          </button>
          <button
            class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all cursor-pointer"
            data-sample="motivation"
          >
            ⚡ Viral Beast
          </button>
          <button
            class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all cursor-pointer"
            data-sample="tutorial"
          >
            💡 Quick Tip
          </button>
        </div>

        <!-- Live Speech Recognition Controls & Language Selector -->
        <div class="flex flex-wrap items-center gap-2.5">
          <select
            id="speech-lang-select"
            class="text-xs px-2.5 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:ring-1 focus:ring-[var(--color-link)] cursor-pointer"
            aria-label="Select speech language"
          >
            <option value="auto" selected>🌐 Auto-Detect Language</option>
            <option value="en-US">🇺🇸 English (US)</option>
            <option value="en-GB">🇬🇧 English (UK)</option>
            <option value="en-IN">🇮🇳 English (India)</option>
            <option value="pt-BR">🇧🇷 Portuguese (Brasil)</option>
            <option value="es-ES">🇪🇸 Spanish (Español)</option>
            <option value="fr-FR">🇫🇷 French (Français)</option>
            <option value="de-DE">🇩🇪 German (Deutsch)</option>
            <option value="hi-IN">🇮🇳 Hindi (हिन्दी)</option>
            <option value="ja-JP">🇯🇵 Japanese (日本語)</option>
            <option value="zh-CN">🇨🇳 Chinese (Mandarin)</option>
            <option value="ar-SA">🇸🇦 Arabic (العربية)</option>
            <option value="it-IT">🇮🇹 Italian (Italiano)</option>
          </select>

          <button
            id="live-speech-btn"
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-all shadow-l1 shrink-0 cursor-pointer"
          >
            <span id="mic-icon">🎙️</span>
            <span id="mic-label">Record Voice (Live AI Speech)</span>
            <span
              id="mic-pulse"
              class="hidden w-2 h-2 rounded-full bg-rose-500 animate-ping"
            ></span>
          </button>
        </div>
      </div>

      <!-- Live Speech Real-time Preview Box -->
      <div
        id="live-speech-preview-box"
        class="hidden p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-emerald-500/30 text-xs flex flex-col gap-2 transition-all"
      >
        <div class="flex items-center justify-between text-[var(--color-mute)]">
          <span
            class="flex items-center gap-1.5 text-emerald-500 font-semibold text-xs"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"
            ></span>
            Live Voice Recognition Active
          </span>
          <span
            id="speech-timer"
            class="font-mono text-xs font-bold text-[var(--color-ink)]"
            >00:00</span
          >
        </div>
        <p
          id="live-speech-preview-text"
          class="font-medium text-[var(--color-ink)] italic text-sm min-h-[22px]"
        >
          Listening... Start speaking into your microphone.
        </p>
      </div>

      <!-- Privacy & Local Processing Banner -->
      <div
        class="p-3.5 rounded-xl bg-[var(--color-link-bg-soft)] border border-[var(--color-link)]/20 flex items-start gap-2.5 text-xs text-[var(--color-ink)]"
      >
        <span class="text-base shrink-0">✨</span>
        <div class="flex flex-col gap-0.5">
          <span class="font-bold"
            >100% Free Client-Side Video & Audio Subtitle Engine</span
          >
          <span class="text-[var(--color-body)]"
            >Your files are processed 100% locally in your browser. Fast rendering, zero server uploads, zero subscription limits.</span
          >
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: Script to Subtitle Synchronizer ───────────── -->
    <div
      id="panel-script"
      role="tabpanel"
      class="hidden p-6 md:p-8 flex flex-col gap-6"
    >
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">
          {t(lang, "script.title")}
        </h3>
        <p class="text-sm text-[var(--color-body)]">
          {t(lang, "script.subtitle")}
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <label
            for="script-textarea"
            class="text-xs font-semibold uppercase tracking-wider text-[var(--color-mute)]"
            >Raw Transcript / Dialogue / Content Script</label
          >
          <button
            id="insert-sample-script"
            class="text-xs font-medium text-[var(--color-link)] hover:underline cursor-pointer"
          >
            {t(lang, "script.sampleBtn")}
          </button>
        </div>
        <textarea
          id="script-textarea"
          rows="6"
          class="w-full p-4 text-sm rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-[var(--color-ink)] focus:outline-none focus:ring-2 focus:ring-[var(--color-link)] focus:ring-offset-1 font-sans transition-all placeholder:text-[var(--color-mute)]"
          placeholder="Paste your video dialogue or script here... (e.g. This secret strategy got me 1 million views in 30 days without spending a dollar on ads...)"></textarea>
      </div>

      <!-- Pacing Controls -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]"
      >
        <div class="flex flex-col gap-2">
          <div class="flex justify-between items-center text-xs font-medium">
            <span class="text-[var(--color-body)]">{t(lang, "script.wpm")}</span
            >
            <span
              id="wpm-val"
              class="font-mono text-[var(--color-ink)] font-bold">160 WPM</span
            >
          </div>
          <input
            id="wpm-slider"
            type="range"
            min="100"
            max="260"
            step="10"
            value="160"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
          <span class="text-[11px] text-[var(--color-mute)]"
            >Standard conversational speaking pace is ~150-170 WPM.</span
          >
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex justify-between items-center text-xs font-medium">
            <span class="text-[var(--color-body)]"
              >{t(lang, "script.wordsPerLine")}</span
            >
            <span
              id="words-val"
              class="font-mono text-[var(--color-ink)] font-bold">3 words</span
            >
          </div>
          <input
            id="words-slider"
            type="range"
            min="1"
            max="8"
            step="1"
            value="3"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
          <span class="text-[11px] text-[var(--color-mute)]"
            >Short lines (2-4 words) generate highest viewer retention on TikTok & Reels.</span
          >
        </div>
      </div>

      <button
        id="generate-script-cues-btn"
        class="inline-flex items-center justify-center gap-2 h-12 px-6 text-sm font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l2 self-start cursor-pointer"
      >
        <span>⚡</span>
        <span>{t(lang, "script.generateBtn")}</span>
      </button>
    </div>

    <!-- ─── TAB 3: Live Video Studio & Editor ────────────────── -->
    <div
      id="panel-editor"
      role="tabpanel"
      class="hidden p-6 md:p-8 flex flex-col gap-8"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Video Player & Subtitle Canvas (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <label
              for="custom-media-input"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all cursor-pointer"
            >
              <span>📁</span>
              <span id="upload-media-btn-text">Upload Video / Audio</span>
              <input
                id="custom-media-input"
                type="file"
                accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a,.aac"
                class="sr-only"
              />
            </label>
            <!-- Aspect Ratio Switcher -->
            <div
              class="flex items-center gap-1 bg-[var(--color-canvas-soft)] p-1 rounded-lg border border-[var(--color-hairline)] text-xs"
            >
              <button
                class="aspect-btn px-2.5 py-1 rounded font-medium bg-[var(--color-canvas)] text-[var(--color-ink)] shadow-l1 cursor-pointer"
                data-ratio="9-16">9:16 (Reels)</button
              >
              <button
                class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] cursor-pointer"
                data-ratio="16-9">16:9 (YouTube)</button
              >
              <button
                class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] cursor-pointer"
                data-ratio="1-1">1:1 (Post)</button
              >
            </div>
          </div>

          <!-- Video / Audio Container Box -->
          <div
            id="video-viewport"
            class="relative w-full max-w-[340px] mx-auto aspect-[9/16] bg-zinc-950 rounded-2xl overflow-hidden shadow-2xl border border-[var(--color-hairline)] flex items-center justify-center select-none group transition-all duration-200"
          >
            <!-- Canvas Animated Background Generator & Waveform -->
            <canvas id="motion-canvas" class="w-full h-full object-cover"
            ></canvas>

            <!-- User HTML5 Video Tag -->
            <video
              id="user-video"
              class="hidden w-full h-full object-contain bg-black"
              playsinline
              preload="auto"></video>

            <!-- User HTML5 Audio Tag (for audio-only files) -->
            <audio id="user-audio" class="hidden" preload="auto"></audio>

            <!-- Subtitle Overlay Container -->
            <div
              id="subtitle-overlay-box"
              class="absolute left-4 right-4 pointer-events-none transition-all flex justify-center text-center bottom-[18%]"
            >
              <div
                id="subtitle-rendered-text"
                class="sub-style-hormozi text-2xl font-bold tracking-tight text-center max-w-full px-3 py-1.5 leading-snug transition-transform"
              >
                <!-- Words injected dynamically by JS -->
                GENERATE <span class="word-active">VIRAL</span> SUBTITLES
              </div>
            </div>

            <!-- Big Play/Pause Button on Hover -->
            <button
              id="video-play-btn"
              class="absolute w-14 h-14 rounded-full bg-white/25 backdrop-blur-md border border-white/40 text-white flex items-center justify-center text-xl hover:scale-110 transition-transform shadow-lg group-hover:opacity-100 opacity-80 cursor-pointer"
              aria-label="Play or pause media preview"
            >
              <span id="play-icon">▶</span>
            </button>

            <!-- Audio Playing Badge (if audio mode active) -->
            <div
              id="audio-badge"
              class="hidden absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-[11px] font-medium flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="audio-filename-badge">Audio Track Active</span>
            </div>
          </div>

          <!-- Player Controls Bar -->
          <div
            class="flex flex-col gap-2.5 p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]"
          >
            <div class="flex items-center gap-3">
              <button
                id="mini-play-btn"
                class="w-8 h-8 rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs text-[var(--color-ink)] flex items-center justify-center font-bold hover:bg-[var(--color-ink)] hover:text-[var(--color-on-primary)] transition-colors cursor-pointer"
                title="Play/Pause (Spacebar)"
              >
                ▶
              </button>
              <input
                id="video-seekbar"
                type="range"
                min="0"
                max="100"
                value="0"
                step="0.1"
                class="flex-1 accent-[var(--color-link)] cursor-pointer"
              />
              <span
                id="time-display"
                class="font-mono text-xs font-medium text-[var(--color-mute)] whitespace-nowrap"
                >00:00 / 00:15</span
              >
            </div>

            <!-- Secondary Player Tools: Speed & Volume -->
            <div class="flex items-center justify-between text-xs pt-1 border-t border-[var(--color-hairline)]">
              <div class="flex items-center gap-2">
                <span class="text-[var(--color-mute)]">Speed:</span>
                <div class="flex items-center gap-1">
                  {['0.75', '1', '1.25', '1.5'].map((spd) => (
                    <button
                      class:list={[
                        'speed-btn px-2 py-0.5 rounded text-[11px] font-mono transition-colors cursor-pointer',
                        spd === '1'
                          ? 'bg-[var(--color-ink)] text-[var(--color-on-primary)]'
                          : 'text-[var(--color-body)] hover:bg-[var(--color-canvas-soft-2)]'
                      ]}
                      data-speed={spd}
                    >
                      {spd}x
                    </button>
                  ))}
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button
                  id="mute-toggle-btn"
                  class="text-xs text-[var(--color-body)] hover:text-[var(--color-ink)] cursor-pointer"
                  title="Toggle Mute"
                >
                  🔊
                </button>
                <input
                  id="volume-slider"
                  type="range"
                  min="0"
                  max="1"
                  step="0.05"
                  value="1"
                  class="w-16 accent-[var(--color-link)] cursor-pointer"
                  title="Volume"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Content Creator Tools & Timeline (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          <!-- Style Preset Cards Grid -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <h4
                class="text-sm font-bold uppercase tracking-wider text-[var(--color-ink)]"
              >
                {t(lang, "styles.title")}
              </h4>
              <span class="text-xs text-[var(--color-mute)]"
                >Click style to preview instantly</span
              >
            </div>

            <div
              class="grid grid-cols-2 sm:grid-cols-3 gap-2.5"
              id="style-presets-grid"
            >
              {
                stylePresets.map((preset, idx) => (
                  <button
                    class:list={[
                      "style-preset-btn p-3 rounded-xl border text-start flex flex-col gap-1 transition-all cursor-pointer",
                      idx === 0
                        ? "border-[var(--color-link)] bg-[var(--color-link-bg-soft)] ring-2 ring-[var(--color-link)]/20"
                        : "border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:border-[var(--color-hairline-strong)]",
                    ]}
                    data-style={preset.id}
                  >
                    <div class="flex items-center gap-1.5">
                      <span class="text-lg" aria-hidden="true">
                        {preset.icon}
                      </span>
                      <span class="text-xs font-bold text-[var(--color-ink)] truncate">
                        {t(lang, preset.nameKey as any) || preset.id}
                      </span>
                    </div>
                    <span class="text-[11px] text-[var(--color-mute)] leading-tight line-clamp-2">
