                  {[
                    { color: '#facc15', label: 'Yellow' },
                    { color: '#38bdf8', label: 'Cyan' },
                    { color: '#4ade80', label: 'Emerald' },
                    { color: '#ff0080', label: 'Hot Pink' },
                    { color: '#ff5722', label: 'Flame' },
                    { color: '#ffffff', label: 'White' },
                  ].map((item, idx) => (
                    <button
                      class:list={[
                        'color-dot-btn w-6 h-6 rounded-full border border-black/20 transition-transform hover:scale-110 cursor-pointer',
                        idx === 0 ? 'ring-2 ring-offset-2 ring-[var(--color-ink)] scale-110' : ''
                      ]}
                      style={`background-color: ${item.color};`}
                      data-color={item.color}
                      title={item.label}
                    ></button>
                  ))}
                </div>
              </div>

              <!-- Quick Case Switcher & Emojis Injector -->
              <div class="flex items-center gap-2">
                <div class="flex items-center rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-0.5 text-xs">
                  <button id="case-upper-btn" class="px-2 py-1 rounded font-bold bg-[var(--color-ink)] text-[var(--color-on-primary)] cursor-pointer">UPPER</button>
                  <button id="case-title-btn" class="px-2 py-1 rounded text-[var(--color-body)] hover:text-[var(--color-ink)] cursor-pointer">Title</button>
