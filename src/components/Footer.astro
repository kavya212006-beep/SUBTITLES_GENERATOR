---
import { t, getLocalizedUrl } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: string; }
const { lang } = Astro.props;

const footerLinks = {
  product: [
    { key: 'footer.studio' as const, path: '/#subtitle-studio' },
    { key: 'footer.styles' as const, path: '/subtitle-styles' },
    { key: 'footer.howItWorks' as const, path: '/how-it-works' },
  ],
  resources: [
    { key: 'footer.srtGuide' as const, path: '/how-it-works#srt-guide' },
    { key: 'footer.vttGuide' as const, path: '/how-it-works#vtt-guide' },
    { key: 'footer.seoCaptions' as const, path: '/how-it-works#seo-guide' },
  ],
  company: [
    { key: 'footer.about' as const, path: '/about' },
    { key: 'footer.contact' as const, path: '/about#contact' },
  ],
  legal: [
    { key: 'footer.privacy' as const, path: '/about#privacy' },
    { key: 'footer.terms' as const, path: '/about#terms' },
  ],
};
---

<footer class="bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] mt-auto transition-colors" role="contentinfo">
  <!-- Main footer content -->
  <div class="container-page py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-12">

      <!-- Brand column -->
      <div class="lg:col-span-2 flex flex-col gap-4">
        <!-- Logo -->
        <a href={getLocalizedUrl(lang, '/')} class="flex items-center gap-2.5 w-fit" aria-label="Subtitle Generator Free">
          <div class="w-8 h-8 rounded-xl bg-[var(--color-ink)] flex items-center justify-center transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-on-primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="4"></rect>
              <path d="M7 15h3a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1H7"></path>
              <path d="M14 15h3a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-3"></path>
            </svg>
          </div>
          <span class="text-sm font-bold text-[var(--color-ink)]">Subtitle Generator Free</span>
        </a>

        <p class="text-sm text-[var(--color-body)] leading-relaxed max-w-xs">
          Free AI-powered subtitle generator. Transcribe audio, synchronize scripts, style viral captions, and export SRT or video in seconds.
        </p>

        <!-- Privacy badge -->
        <p class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <path d="M6 0.5L1 2.5V5.5C1 8.39 3.18 11.09 6 11.75C8.82 11.09 11 8.39 11 5.5V2.5L6 0.5Z"/>
          </svg>
          {t(lang, 'footer.privacyNote')}
        </p>

        <!-- Language & Theme switcher in footer -->
        <div class="mt-2 flex items-center gap-2">
          <ThemeToggle />
          <LanguageSwitcher lang={lang} currentPath={Astro.url.pathname} />
        </div>
      </div>

      <!-- Links columns -->
      {Object.entries(footerLinks).map(([section, links]) => (
        <div class="flex flex-col gap-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">
            {t(lang, `footer.${section}` as any)}
          </h4>
          <ul class="flex flex-col gap-2 list-none p-0 m-0">
            {links.map(({ key, path }) => (
              <li>
                <a
                  href={path.startsWith('/') ? getLocalizedUrl(lang, path) : path}
                  class="text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors"
                >
                  {t(lang, key as any)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] py-6">
    <div class="container-page flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-mute)]">
      <p>{t(lang, 'footer.copyright')}</p>
      <div class="flex items-center gap-6">
        <a href={getLocalizedUrl(lang, '/about#privacy')} class="hover:text-[var(--color-ink)] transition-colors">{t(lang, 'footer.privacy')}</a>
        <a href={getLocalizedUrl(lang, '/about#terms')} class="hover:text-[var(--color-ink)] transition-colors">{t(lang, 'footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>
