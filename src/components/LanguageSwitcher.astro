---
import { t, getLocalizedUrl } from '../i18n/utils';
import { localeInfo, locales, type Locale } from '../i18n/ui';

interface Props {
  lang: string;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const currentInfo = localeInfo[lang as Locale];

// Build locale URLs from current path by substituting locale prefix
function getLocaleUrl(targetLocale: Locale, currentPath: string, currentLang: string): string {
  // Strip current lang prefix if present
  let basePath = currentPath;
  if (currentLang !== 'en') {
    basePath = currentPath.replace(new RegExp(`^/${currentLang}`), '') || '/';
  }
  return getLocalizedUrl(targetLocale, basePath);
}
---

<div class="relative" id="lang-switcher-wrapper">
  <!-- Trigger button -->
  <button
    id="lang-trigger"
    class="flex items-center gap-1.5 px-2.5 h-8 text-xs font-medium text-[var(--color-body)] border border-[var(--color-hairline)] rounded-lg hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] transition-colors bg-[var(--color-canvas)] shadow-l1"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t(lang, 'lang.switch')}
  >
    <!-- Globe icon -->
    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM4.5 7.5a12.44 12.44 0 0 0 .24 2.5H6.5V7.5H4.5Zm3.5 0V10h3.26A10.45 10.45 0 0 0 11.5 7.5H8Zm0-1.5h3.26A10.45 10.45 0 0 0 8 1.67V6ZM6.5 6V1.67A10.45 10.45 0 0 0 3.24 6H6.5ZM3.07 7.5A11.94 11.94 0 0 0 3 8a11.94 11.94 0 0 0 .24 2H4.5A12.44 12.44 0 0 1 4.26 8c0-.17.01-.33.02-.5H3.07Zm.62 4h1.28A10.45 10.45 0 0 0 8 14.33 10.45 10.45 0 0 1 3.69 11.5ZM8 14.33A10.45 10.45 0 0 0 11.31 11.5H10a10.45 10.45 0 0 1-2 2.83ZM11.5 10H9.74a12.44 12.44 0 0 1 .24 2H12.43A8.04 8.04 0 0 0 12 10h-.5Zm.93-2.5H10.5a12.44 12.44 0 0 1 .24 2h1.5a11.94 11.94 0 0 0 .24-2c0-.17-.01-.33-.05-.5Z"/>
    </svg>
    <span>{currentInfo?.flag} {currentInfo?.label}</span>
    <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" class="opacity-50" aria-hidden="true">
      <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="lang-dropdown"
    role="listbox"
    aria-label="Select language"
    data-open="false"
    class="lang-dropdown hidden absolute top-full mt-2 end-0 min-w-[190px] bg-[var(--color-canvas)] rounded-xl border border-[var(--color-hairline)] shadow-l4 overflow-hidden z-50 py-1.5 animate-in fade-in"
  >
    {locales.map((locale) => {
      const info = localeInfo[locale];
      const isActive = locale === lang;
      const href = getLocaleUrl(locale, currentPath, lang);
      return (
        <a
          href={href}
          role="option"
          aria-selected={isActive}
          class:list={[
            'flex items-center gap-2.5 px-3.5 py-2 text-sm transition-colors',
            isActive
              ? 'text-[var(--color-ink)] font-semibold bg-[var(--color-canvas-soft)]'
              : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)]'
          ]}
        >
          <span class="text-base leading-none">{info.flag}</span>
          <span class="flex-1">{info.label}</span>
          {isActive && (
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  const trigger = document.getElementById('lang-trigger');
  const dropdown = document.getElementById('lang-dropdown');

  function toggle(open: boolean) {
    if (open) {
      dropdown?.classList.remove('hidden');
      dropdown?.setAttribute('data-open', 'true');
      trigger?.setAttribute('aria-expanded', 'true');
    } else {
      dropdown?.classList.add('hidden');
      dropdown?.setAttribute('data-open', 'false');
      trigger?.setAttribute('aria-expanded', 'false');
    }
  }

  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = dropdown?.getAttribute('data-open') === 'true';
    toggle(!isOpen);
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target as Node) && e.target !== trigger) {
      toggle(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggle(false);
  });
</script>
