---
import { t, getLocalizedUrl } from '../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <!-- Mesh Gradient Background Effect -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[1000px] h-[500px] rounded-full blur-3xl opacity-30 dark:opacity-20 mesh-gradient"></div>
  </div>

  <div class="container-page max-w-4xl mx-auto text-center flex flex-col items-center gap-6">

    <!-- Top Feature Announcement Pill -->
    <a
      href={getLocalizedUrl(lang, '/subtitle-styles')}
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-pill text-xs font-semibold bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 hover:border-[var(--color-hairline-strong)] hover:shadow-l2 transition-all text-[var(--color-ink)] group"
    >
      <span class="w-2 h-2 rounded-full bg-[var(--color-success)] animate-pulse"></span>
      <span>{t(lang, 'banner.text')}</span>
      <span class="text-[var(--color-mute)] group-hover:translate-x-0.5 transition-transform">→</span>
    </a>

    <!-- Main Headline -->
    <div class="flex flex-col gap-4">
      <span class="eyebrow text-center">{t(lang, 'hero.eyebrow')}</span>
      <h1 class="display-xl text-[var(--color-ink)] font-extrabold tracking-tight">
        {t(lang, 'hero.title')}
      </h1>
      <p class="text-base md:text-lg text-[var(--color-body)] max-w-2xl mx-auto leading-relaxed">
        {t(lang, 'hero.subtitle')}
      </p>
    </div>

    <!-- CTA Group -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="#subtitle-studio"
        class="inline-flex items-center justify-center h-12 px-8 text-sm font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l2"
      >
        {t(lang, 'hero.cta.start')}
      </a>
      <a
        href={getLocalizedUrl(lang, '/subtitle-styles')}
        class="inline-flex items-center justify-center h-12 px-6 text-sm font-medium rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all"
      >
        {t(lang, 'hero.cta.styles')}
      </a>
    </div>

    <!-- Quick Badges -->
    <div class="flex flex-wrap items-center justify-center gap-6 pt-4 text-xs font-medium text-[var(--color-mute)]">
      <span class="flex items-center gap-1.5">⚡ Instant Transcribe</span>
      <span class="flex items-center gap-1.5">✨ Word-by-Word Animations</span>
      <span class="flex items-center gap-1.5">🔒 100% Client-Side Privacy</span>
      <span class="flex items-center gap-1.5">🚫 Zero Watermarks</span>
    </div>

  </div>
</section>
